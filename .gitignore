# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Korean PDF font (fetched by scripts/ensure-noto-kr-font.mjs on postinstall)
public/fonts/*.otf
public/fonts/*.ttf

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next-pwa (generated at build)
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/worker-*.js
public/worker-*.js.map

/lib/generated/prisma
.env*.local
public/fallback-*.js
.neon
tmp/
tkad-web/
scripts/debug-*.ts
scripts/diagnose-*.ts
scripts/trace-*.mts
scripts/trace-*.ts
scripts/test-*.ts
scripts/verify-*.ts
scripts/screenshot-*
scripts/simulate-*.ts
scripts/print-admin-*.ts
*.png
!docs/screenshots/
!docs/screenshots/pr4-baseline/
!docs/screenshots/pr4-baseline/*.png
!docs/screenshots/pr4-after/
!docs/screenshots/pr4-after/*.png
scripts/fix-*.ts
