# ═══ Vercel Phase 2 — 필수 환경 변수 체크리스트 ═════════════════
# 아래 값을 Vercel Project → Settings → Environment Variables에 넣고 재배포하세요.
#
# 1) ADMIN_PASSWORD          — 관리자 로그인 비밀번호 (프로덕션 필수)
# 2) ADMIN_SESSION_SECRET      — 32자 이상 무작위 문자열 (세션 서명)
# 3) DATABASE_URL             — Neon PostgreSQL 연결 문자열
# 4) RESEND_API_KEY           — 이메일 발송 (문의 알림, 견적, 크론 다이제스트 등)
# 5) CLOUDINARY_URL 또는 분리 키 — 이미지 업로드 (매체 허브, 송출 증빙 등)
#    CLOUDINARY_URL 형식: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
#    분리 키: CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET
# 6) NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY + TOSS_PAYMENTS_SECRET_KEY — 즉시 예약 결제 (아래 Toss 섹션)
#
# ─── Database (Neon PostgreSQL) ───────────────────────────────
# Vercel: add DATABASE_URL in Project → Settings → Environment Variables, then deploy.
# Local: prisma db push (or migrate) after setting DATABASE_URL in .env
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=verify-full"
DATABASE_POOL_MAX=15

# ─── User auth (Kakao OAuth + 세션) ───────────────────────────
# Kakao Developers → 앱 → 카카오 로그인 → Redirect URI:
#   https://tkad.co.kr/api/auth/callback/kakao
#   http://localhost:3000/api/auth/callback/kakao (로컬)
# client_id: KAKAO_CLIENT_ID (또는 기존 KAKAO_REST_API_KEY 와 동일한 REST API 키)
# client_secret: KAKAO_CLIENT_SECRET (개발자 콘솔 → 보안 → Client Secret)
# KAKAO_CLIENT_ID=""
# KAKAO_CLIENT_SECRET=""
# (이미 KAKAO_REST_API_KEY 가 있으면 CLIENT_ID 는 생략 가능 — SECRET 은 필수)
# Google Cloud Console → OAuth 2.0 Client → Redirect URI:
#   https://tkad.co.kr/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google (로컬)
# GOOGLE_CLIENT_ID=""  (레거시: GOOGLE_OAUTH_CLIENT_ID 동일 값)
# GOOGLE_CLIENT_SECRET=""  (레거시: GOOGLE_OAUTH_CLIENT_SECRET)
# Naver Developers → 애플리케이션 → API 설정 → 로그인 오픈 API → Callback URL:
#   https://tkad.co.kr/api/auth/callback/naver
#   http://localhost:3000/api/auth/callback/naver (로컬)
# NAVER_CLIENT_ID=""
# NAVER_CLIENT_SECRET=""
# NextAuth 서명 — openssl rand -base64 32 (하나 이상 필수, 동일 값 권장)
# AUTH_SECRET=""
# USER_SESSION_SECRET=""
# NEXTAUTH_SECRET=""  (v4 레거시, AUTH_SECRET 과 동일하게 맞출 것)
# OAuth Redirect URI 기준 (도메인만, 경로 없음). Vercel Production 필수.
# AUTH_URL="https://tkad.co.kr"
# NEXTAUTH_URL="https://tkad.co.kr"

# ─── Site ─────────────────────────────────────────────────────
# SEO·OG·sitemap·OAuth Redirect URI — 프로덕션 canonical 도메인
NEXT_PUBLIC_SITE_URL="https://tkad.co.kr"
SITE_URL="https://tkad.co.kr"
NODE_ENV="production"
# Search Console / 네이버 서치어드바이저 — HTML 메타 태그 검증 (layout metadata)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="FI7xVJqHr8-tGYIqNHZOeeoErc__5WwvitOm_lQIMoo"
# NEXT_PUBLIC_NAVER_SITE_VERIFICATION="ce507d6ae12455e2d660a0fecd6f810d6671ec1d"
# GA4 (DB 어드민 설정 없을 때 폴백)
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
#
# Sentry (선택)
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
# SENTRY_AUTH_TOKEN=""  # CI source maps 업로드용
# SLACK_OPS_ERROR_ALERTS=true  # 5xx 즉시 Slack (기본 off, 백업 실패·시간별 리포트는 항상)
#
# 문의 자동 배정 — JSON 배열 (업종 전문 담당 optional)
# SALES_TEAM_JSON=[{"email":"sales1@tkad.co.kr","name":"김영업","industries":["beauty_fashion"]},{"email":"sales2@tkad.co.kr","name":"이영업"}]
#
# SNS 발행 웹훅 (Zapier/Make → Instagram·카카오)
# SNS_INSTAGRAM_WEBHOOK_URL=
# SNS_KAKAO_WEBHOOK_URL=
#
# 광고주 주간 리포트 담당자 메모
# ADVERTISER_REPORT_MANAGER_NOTE=담당 컨설턴트 홍길동 · 02-515-2772
# (서버 전용 별칭, 동일 값) GOOGLE_SITE_VERIFICATION=""  NAVER_SITE_VERIFICATION=""
#
# Google HTML 파일 검증: Search Console에서 받은 googleXXXXXXXX.html 을
# public/ 에 그대로 두면 https://tkad.co.kr/googleXXXXXXXX.html 로 제공됩니다.
#
# Sitemap ping (주 1회 Vercel Cron → /api/ping-sitemap, CRON_SECRET 필요)
# SITEMAP_PING_DISABLED=1  # ping 비활성화 시

# ─── Admin (/ko/admin, /en/admin) ─────────────────────────────
# REQUIRED in production (NODE_ENV=production): without these, login returns 503.
# Optional locally: defaults to admin / thinkad2024 and a dev session secret.
# Session cookie lasts 7 days. Use a long random string for ADMIN_SESSION_SECRET.
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD="your-strong-password"
# ADMIN_SESSION_SECRET="generate-a-long-random-string-min-32-chars"
#
# 디버깅(임시): 관리자 API 인증 실패 시 서버 로그에 사유 코드 출력 — 운영에서는 끄세요.
# ADMIN_AUTH_DEBUG=1
# 인증·DB 게이트 통과 시에도 로그(선택)
# ADMIN_AUTH_DEBUG_VERBOSE=1

# ─── Email (Resend preferred; otherwise SMTP) ───────────────────
# Resend: https://resend.com — verify domain, then set API key + from address.
# RESEND_API_KEY="re_..."
# RESEND_FROM="THINKAD <onboarding@yourdomain.com>"

# Optional SMTP (used when Resend is not set)
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="THINKAD <noreply@yourdomain.com>"

# New contact form (/api/contact): notify this inbox (requires Resend or SMTP).
# CONTACT_ALERT_EMAIL="ops@example.com"
#
# Cloudflare Turnstile (contact form) — https://developers.cloudflare.com/turnstile/
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAA..."
# TURNSTILE_SECRET_KEY="0x4AAAA..."

# Upstash Redis (rate limiting on Vercel) — https://upstash.com/
# UPSTASH_REDIS_REST_URL="https://..."
# UPSTASH_REDIS_REST_TOKEN="..."

# PRO 월 구독 상시 할인율 (%) — 기본값 0(코드). Preview 검증 시에만 설정 권장.
# NEXT_PUBLIC_PRO_DISCOUNT_PERCENT=20
# PRO_DISCOUNT_PERCENT=20  # 서버 전용(선택, NEXT_PUBLIC보다 우선). main 머지 전 Preview env 제거.

# 전자계약 서명 완료 시 PDF 사본 (미설정 시 CONTACT_ALERT_EMAIL 사용).
# OOH 전자계약 서명 완료 시 감사 로그+PDF 증거 이메일 (광고주 + 운영 양측)
# OOH_CONTRACT_ALERT_EMAIL="ops@example.com"

# ─── 카카오 알림톡 (알리고 Aligo) ─────────────────────────────
# https://smartsms.aligo.in/ — 비즈니스 채널·알림톡 템플릿 사전 등록 필요
# 템플릿 코드: UL_1338 (PRO 체험 만료), TKAD_QUOTE_SENT, TKAD_CAMPAIGN_CONFIRMED,
#   TKAD_CAMPAIGN_TOMORROW, TKAD_REPORT_READY (lib/kakao-alimtalk.ts 본문과 일치)
# TKAD_INQUIRY_RECEIVED — 알리고 미등록, SMS(LMS)만 발송
# KAKAO_ALIMTALK_API_KEY=""       # 알리고 API key (미설정 시 ALIGO_API_KEY 사용)
# KAKAO_ALIMTALK_SENDER_KEY=""    # 카카오 채널 senderkey
# ALIGO_USER_ID=""                # 알리고 로그인 ID
# ALIGO_API_KEY=""                # SMS 대체 발송용 (미설정 시 KAKAO_ALIMTALK_API_KEY)
# KAKAO_ALIMTALK_PHONE=""         # 발신 번호 (하이픈 없이, 필수)
# KAKAO_ALIMTALK_TEST_MODE=1      # 테스트 발송 (운영 전)
# 미설정 시 발송 스킵(서버 콘솔 로그만). 알림톡 실패 시 SMS 대체(apis.aligo.in).

# Optional: POST JSON to Zapier / Slack / custom bridge (Kakao Biz 등 연동용).
# INTERNAL_ALERT_WEBHOOK_URL="https://hooks.zapier.com/..."
# INTERNAL_ALERT_WEBHOOK_SECRET="optional-hmac-key"  # sends X-Tkad-Signature: sha256=...

# OOH 고객 견적·부킹 파이프라인 — 텔레그램 알림 (BotFather 토큰 + chat id)
# TELEGRAM_BOT_TOKEN="123456:ABC..."
# TELEGRAM_ADMIN_CHAT_ID="8266530721"
# 관리자 링크 버튼에 SITE_URL 또는 NEXT_PUBLIC_SITE_URL 사용

# Optional: separate inbox for /api/cron/weekly-summary (외부 스케줄러 호출 시).
# WEEKLY_SUMMARY_EMAIL="ops@example.com"

# 견적/완료 PDF 한글 폰트 경로 (기본: public/fonts/NotoSansKR-Regular.otf, postinstall 시 자동 다운로드).
# QUOTE_PDF_KR_FONT_PATH="public/fonts/NotoSansKR-Regular.otf"
# 관리자 정식 견적서 PDF 상·하단 회사/계좌 (미설정 시 플레이스홀더).
# QUOTE_ISSUER_ADDRESS=""
# QUOTE_ISSUER_REG_NO=""
# QUOTE_ISSUER_TEL=""
# QUOTE_ISSUER_EMAIL=""
# QUOTE_BANK_NAME=""
# QUOTE_BANK_ACCOUNT=""
# QUOTE_BANK_HOLDER=""
# QUOTE_SALES_TITLE=""
# 선택: PDF 상단 로고 PNG — public/brand/thinkad-logo.png
# 선택: 견적서 직인 PNG — public/brand/thinkad-stamp.png (또는 QUOTE_STAMP_URL)
# QUOTE_STAMP_URL="https://tkad-cdn.b-cdn.net/tkad/Test/tkad_impress.png"

# ─── Bunny Storage + CDN (admin / planner image upload) ───────
# Bunny.net → Storage Zone 생성 후 Pull Zone 연결.
# Pull Zone hostname 예: tkad-cdn.b-cdn.net → BUNNY_CDN_BASE_URL
# Storage Zone 이름 → BUNNY_STORAGE_ZONE
# Storage Zone FTP/API Password → BUNNY_STORAGE_API_KEY
# Pull Zone이 "Domain suspended or not configured" 이면 Bunny 대시보드에서
# Pull Zone 재활성화 또는 Storage Zone 재연결 필요.
# BUNNY_CDN_BASE_URL="https://tkad-cdn.b-cdn.net"
# BUNNY_STORAGE_ZONE="your-storage-zone"
# BUNNY_STORAGE_API_KEY="your-storage-api-key"
# BUNNY_STORAGE_HOST="https://storage.bunnycdn.com"

# ─── Cloudinary (admin /media-hub image upload) ───────────────
# 단일 URL (Vercel 대시보드에서 복사한 형식과 동일하게 사용 가능):
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
# 또는 분리 변수:
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# CLOUDINARY_UPLOAD_FOLDER="tkad/media"
# 전자계약 서명 PDF (raw). 미설정 시 tkad/contracts — Cloudinary 미구성 시 PDF는 DB에 Base64로 보관됩니다.
# CLOUDINARY_CONTRACT_FOLDER="tkad/contracts"

# ─── Web Push (PWA) — VAPID keys from: npx web-push generate-vapid-keys ─
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:support@thinkad.co.kr"
# NEXT_PUBLIC_KAKAO_JS_KEY=""  # Kakao Link 공유 (지도 키와 별도)

# ─── CRM Slack (팔로업 cron → SLACK_WEBHOOK_URL) ───────────────
# /api/cron/crm-followup-alerts — 매일 09:00 KST (00:00 UTC)

# ─── Cron (Vercel: CRON_SECRET + Authorization: Bearer) ───────
# /api/cron/admin-digest — daily digest (문의·견적, D-30/D-7 계약, 24h 송출 시작/종료, 월요일=주간 요약 블록)
# /api/cron/followup-reminders — due-day emails to CRM follow-up remindEmail (Asia/Seoul date)
# /api/cron/weekly-summary — 선택: 외부 Cron으로만 호출 시 주간 단독 메일
# ADMIN_DIGEST_EMAIL="ops@example.com"
# CRON_SECRET="long-random-string"

# ─── Maps ───────────────────────────────────────────────────────
# 공개 사용자 지도: Leaflet + Carto 다크 타일 (API 키 불필요)
#
# NEXT_PUBLIC_KAKAO_MAP_APP_KEY — **카카오 지도 JavaScript 키** (REST API 키와 다름)
#   매체 상세·/media/map·어드민 매체 등록 지도
# Kakao Developers → 내 애플리케이션 → 앱 설정 → 플랫폼 → Web
#   사이트 도메인에 프로덕션 origin 등록 필수:
#     https://app.tkad.co.kr
#     http://localhost:3000 (로컬)
#     https://*.vercel.app (Vercel 프리뷰, 선택)
# NEXT_PUBLIC_KAKAO_MAP_APP_KEY=""
#
# (선택) Google Maps — 레거시 CampaignMonitoringMap fallback
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
#
# Kakao REST (서버 전용, 로컬 API): 주소 검색·키워드·카테고리 검색; 주소→좌표·시·구 보강 및 매체 주변 필드 자동 수집
# https://developers.kakao.com/ → 내 애플리케이션 → 앱 키 → REST API 키
# KAKAO_REST_API_KEY=""
#
# 공공데이터포털 일반 인증키 — 서울교통공사 역별 승하차 → daily_footfall 추정(역 500m 이내)
# https://www.data.go.kr/data/15143845/openapi.do (활용신청 후 Encoding 또는 Decoding 키를 그대로 저장)
# DATA_GO_KR_SERVICE_KEY=""

# ─── Feedback survey (/api/feedback) ──────────────────────────
# When set, each completed survey sends a summary (answers + coupon) here.
# FEEDBACK_ALERT_EMAIL="ops@example.com"

# ─── Public site AI chatbot (/api/chat) — xAI Grok ────────────
# https://console.x.ai/ — OpenAI-compatible Chat Completions; server-side only.
# XAI_API_KEY="xai-..."
# Optional: default grok-2-latest
# XAI_MODEL="grok-2-latest"
# Optional: default 1000 (min 256, max 8192)
# XAI_MAX_TOKENS="1000"

# ─── AI content generation (insights / academy / admin) ─────
# https://console.anthropic.com/ — server-side only; never expose in NEXT_PUBLIC_*.
# ANTHROPIC_API_KEY="sk-ant-api03-..."
# Optional: override default claude-3-5-sonnet-20241022
# ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# 플래너 Step 4·6/7 Claude 추천·제안 논리 (기본 OFF — 미설정 시 규칙 기반만)
# PLANNER_RECOMMEND_USE_CLAUDE="true"

# ─── Tavily Search (insights cron 보강 자료) ────────────────
# https://app.tavily.com/ — 무료 1k req/월 충분.
# 미설정 시 자동 트렌드 리포트는 LLM 내부 지식만으로 작성됨 (graceful).
# TAVILY_API_KEY="tvly-..."

# ─── 트렌드 리포트 월간 cron (매월 1일 00:00 UTC) ───────────
# /api/cron/generate-trend-report — CRON_SECRET + TAVILY + ANTHROPIC + SLACK

# ─── Slack 알림 (insights 검증 결과 라우팅) ─────────────────
# Slack App → Incoming Webhooks → 채널 선택 후 URL 발급.
# https://api.slack.com/messaging/webhooks
# 미설정 시 알림은 silent skip — cron 동작에는 영향 없음.
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T.../B.../..."
# (옵션) verdict 별 채널 분리 — 미지정 시 위 기본 URL 사용:
# SLACK_WEBHOOK_URL_BLOCKED="https://hooks.slack.com/services/.../#content-blocked"
# SLACK_WEBHOOK_URL_WARNINGS="https://hooks.slack.com/services/.../#content-warnings"
