# ─── Database (Neon PostgreSQL) ───────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_POOL_MAX=15

# ─── Site ─────────────────────────────────────────────────────
SITE_URL="https://tkad.co.kr"
NODE_ENV="production"

# ─── Maps (client monitoring /client/monitoring) ──────────────
# Kakao is preferred when set; otherwise Google Maps loads if set.
# NEXT_PUBLIC_KAKAO_MAP_APP_KEY=""
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ─── Feedback survey (/api/feedback) ──────────────────────────
# Admin notification: SMTP must be configured. When set, each completed survey
# sends a summary (answers + coupon) to this address.
# FEEDBACK_ALERT_EMAIL="ops@example.com"
