# ═══ Vercel Phase 2 — 필수 환경 변수 체크리스트 ═════════════════
# 아래 값을 Vercel Project → Settings → Environment Variables에 넣고 재배포하세요.
#
# 1) ADMIN_PASSWORD          — 관리자 로그인 비밀번호 (프로덕션 필수)
# 2) ADMIN_SESSION_SECRET      — 32자 이상 무작위 문자열 (세션 서명)
# 3) DATABASE_URL             — Neon PostgreSQL 연결 문자열
# 4) RESEND_API_KEY           — 이메일 발송 (문의 알림, 견적, 크론 다이제스트 등)
# 5) CLOUDINARY_URL 또는 분리 키 — 이미지 업로드 (매체 허브, 송출 증빙 등)
#    CLOUDINARY_URL 형식: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
#    분리 키: CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET
#
# ─── Database (Neon PostgreSQL) ───────────────────────────────
# Vercel: add DATABASE_URL in Project → Settings → Environment Variables, then deploy.
# Local: prisma db push (or migrate) after setting DATABASE_URL in .env
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_POOL_MAX=15

# ─── Site ─────────────────────────────────────────────────────
SITE_URL="https://tkad.co.kr"
NODE_ENV="production"

# ─── Admin (/ko/admin, /en/admin) ─────────────────────────────
# REQUIRED in production (NODE_ENV=production): without these, login returns 503.
# Optional locally: defaults to admin / thinkad2024 and a dev session secret.
# Session cookie lasts 7 days. Use a long random string for ADMIN_SESSION_SECRET.
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD="your-strong-password"
# ADMIN_SESSION_SECRET="generate-a-long-random-string-min-32-chars"
#
# 디버깅(임시): 관리자 API 인증 실패 시 서버 로그에 사유 코드 출력 — 운영에서는 끄세요.
# ADMIN_AUTH_DEBUG=1
# 인증·DB 게이트 통과 시에도 로그(선택)
# ADMIN_AUTH_DEBUG_VERBOSE=1

# ─── Email (Resend preferred; otherwise SMTP) ───────────────────
# Resend: https://resend.com — verify domain, then set API key + from address.
# RESEND_API_KEY="re_..."
# RESEND_FROM="THINKAD <onboarding@yourdomain.com>"

# Optional SMTP (used when Resend is not set)
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="THINKAD <noreply@yourdomain.com>"

# New contact form (/api/contact): notify this inbox (requires Resend or SMTP).
# CONTACT_ALERT_EMAIL="ops@example.com"

# 전자계약 서명 완료 시 PDF 사본 (미설정 시 CONTACT_ALERT_EMAIL 사용).
# OOH_CONTRACT_ALERT_EMAIL="ops@example.com"

# Optional: POST JSON to Zapier / Slack / custom bridge (Kakao Biz 등 연동용).
# INTERNAL_ALERT_WEBHOOK_URL="https://hooks.zapier.com/..."
# INTERNAL_ALERT_WEBHOOK_SECRET="optional-hmac-key"  # sends X-Tkad-Signature: sha256=...

# OOH 고객 견적·부킹 파이프라인 — 텔레그램 알림 (BotFather 토큰 + chat id)
# TELEGRAM_BOT_TOKEN="123456:ABC..."
# TELEGRAM_ADMIN_CHAT_ID="8266530721"
# 관리자 링크 버튼에 SITE_URL 또는 NEXT_PUBLIC_SITE_URL 사용

# Optional: separate inbox for /api/cron/weekly-summary (외부 스케줄러 호출 시).
# WEEKLY_SUMMARY_EMAIL="ops@example.com"

# 견적/완료 PDF 한글 폰트 경로 (기본: public/fonts/NotoSansKR-Regular.otf, postinstall 시 자동 다운로드).
# QUOTE_PDF_KR_FONT_PATH="public/fonts/NotoSansKR-Regular.otf"
# 관리자 정식 견적서 PDF 상·하단 회사/계좌 (미설정 시 플레이스홀더).
# QUOTE_ISSUER_ADDRESS=""
# QUOTE_ISSUER_REG_NO=""
# QUOTE_ISSUER_TEL=""
# QUOTE_ISSUER_EMAIL=""
# QUOTE_BANK_NAME=""
# QUOTE_BANK_ACCOUNT=""
# QUOTE_BANK_HOLDER=""
# QUOTE_SALES_TITLE=""
# 선택: PDF 상단 로고 PNG — public/brand/thinkad-logo.png

# ─── Cloudinary (admin /media-hub image upload) ───────────────
# 단일 URL (Vercel 대시보드에서 복사한 형식과 동일하게 사용 가능):
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
# 또는 분리 변수:
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# CLOUDINARY_UPLOAD_FOLDER="tkad/media"
# 전자계약 서명 PDF (raw). 미설정 시 tkad/contracts — Cloudinary 미구성 시 PDF는 DB에 Base64로 보관됩니다.
# CLOUDINARY_CONTRACT_FOLDER="tkad/contracts"

# ─── Cron (Vercel: CRON_SECRET + Authorization: Bearer) ───────
# /api/cron/admin-digest — daily digest (문의·견적, D-30/D-7 계약, 24h 송출 시작/종료, 월요일=주간 요약 블록)
# /api/cron/followup-reminders — due-day emails to CRM follow-up remindEmail (Asia/Seoul date)
# /api/cron/weekly-summary — 선택: 외부 Cron으로만 호출 시 주간 단독 메일
# ADMIN_DIGEST_EMAIL="ops@example.com"
# CRON_SECRET="long-random-string"

# ─── Maps (client monitoring /client/monitoring) ──────────────
# Kakao is preferred when set; otherwise Google Maps loads if set.
# NEXT_PUBLIC_KAKAO_MAP_APP_KEY=""
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
#
# Kakao REST (서버 전용, 로컬 API): 주소 검색·키워드·카테고리 검색; 주소→좌표·시·구 보강 및 매체 주변 필드 자동 수집
# https://developers.kakao.com/ → 내 애플리케이션 → 앱 키 → REST API 키
# KAKAO_REST_API_KEY=""
#
# 공공데이터포털 일반 인증키 — 서울교통공사 역별 승하차 → daily_footfall 추정(역 500m 이내)
# https://www.data.go.kr/data/15143845/openapi.do (활용신청 후 Encoding 또는 Decoding 키를 그대로 저장)
# DATA_GO_KR_SERVICE_KEY=""

# ─── Feedback survey (/api/feedback) ──────────────────────────
# When set, each completed survey sends a summary (answers + coupon) here.
# FEEDBACK_ALERT_EMAIL="ops@example.com"

# ─── Public site AI chatbot (/api/chat) — xAI Grok ────────────
# https://console.x.ai/ — OpenAI-compatible Chat Completions; server-side only.
# XAI_API_KEY="xai-..."
# Optional: default grok-2-latest
# XAI_MODEL="grok-2-latest"
# Optional: default 1000 (min 256, max 8192)
# XAI_MAX_TOKENS="1000"

# ─── AI content generation (insights / academy / admin) ─────
# https://console.anthropic.com/ — server-side only; never expose in NEXT_PUBLIC_*.
# ANTHROPIC_API_KEY="sk-ant-api03-..."
# Optional: override default claude-3-5-sonnet-20241022
# ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
