{
  "name": "tkad-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "dev:clean": "node scripts/dev-reset.mjs && next dev",
    "build": "prisma generate && next build --webpack",
    "vercel-build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "seed": "npx tsx prisma/seed.ts",
    "db:check": "node scripts/db-check.mjs",
    "db:push": "node scripts/ensure-database-url.mjs && prisma db push",
    "db:migrate": "node scripts/ensure-database-url.mjs && prisma migrate deploy",
    "db:migrate:status": "node scripts/ensure-database-url.mjs && prisma migrate status",
    "db:migrate:resolve-applied": "node scripts/ensure-database-url.mjs && prisma migrate resolve --applied 20260520120000_web_vitals_ab_testing",
    "db:migrate:resolve-rolled-back": "node scripts/ensure-database-url.mjs && prisma migrate resolve --rolled-back 20260520120000_web_vitals_ab_testing",
    "postinstall": "prisma generate && node scripts/ensure-noto-kr-font.mjs",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": true
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@tosspayments/payment-widget-sdk": "^0.12.1",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "jose": "^5.10.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "next": "^16.2.3",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.8.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.7",
    "pg": "^8.20.0",
    "pretendard": "^1.3.9",
    "prisma": "^7.6.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^2.15.4",
    "resend": "^4.8.0",
    "tailwind-merge": "^3.5.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-signature-canvas": "^1.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "next-pwa": "^5.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
