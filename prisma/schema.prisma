generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CampaignStatus {
  proposal
  negotiation
  contract
  production
  airing
  completed
}

enum MediaAvailability {
  available
  reserved
  maintenance
}

/// 예약 상태 머신.
///   requested  : 광고주가 자가 신청 (운영자 검토 전)
///   tentative  : 어드민 가홀드 (영업·견적 진행 중) — 신규 예약 차단
///   confirmed  : 확정 — 신규 예약 차단
///   cancelled  : 취소됨 — 충돌 판정 제외
///   expired    : requested 후 N일 미응답 자동 만료 (cron)
enum MediaBookingStatus {
  requested
  tentative
  confirmed
  cancelled
  expired
}

enum MediaPricePeriod {
  month
  biweekly
  week
  day
}

enum CrmTier {
  vip
  standard
  lead
}

enum FinancialDocKind {
  quote
  contract
  invoice
}

enum FinancialDocStatus {
  draft
  sent
  paid
  overdue
  cancelled
}

/// 고객 /quote 파이프라인 (관리자 정식 Quote `quotes` 테이블과 별도)
enum OoHQuoteStatus {
  draft
  sent
  booking_requested
  booking_pending
  booking_confirmed
  invoice_sent
  payment_pending
  payment_confirmed
  contract_confirmed
  in_progress
  completed
  cancelled
}

/// 전자계약 (`/quote/[id]/contract`) — 관리자 Quote와 무관
enum OohContractStatus {
  pending
  signed
  confirmed
  cancelled
}

model Media {
  id        String   @id @default(cuid())
  name      String
  nameEn    String?  @map("name_en")
  location  String
  region    String
  /// Catalog code: `digital` | `static` | `mobile` (OOH 유형)
  type      String
  price     Int
  pricePeriod MediaPricePeriod @default(month) @map("price_period")
  /// 가격 옵션 (JSON 배열). 예: [{"label":"20초 기준","price":30000000,"period":"month"},{"label":"15초 기준","price":25000000,"period":"month"}]
  priceOptions Json? @map("price_options")
  image     String?
  width     String?
  height    String?

  description      String?
  subCategory      String?  @map("sub_category")
  tags             String[] @default([])
  district         String?
  city             String?
  /// 이동형(`type=mobile`) 매체 서비스 구역 — 행정구역 5자리 코드 배열 (전국 시·군·구, 예: 서울 강남 `11680`). 공개 지도 폴리곤에 사용.
  coverageDistrictCodes String[] @default([]) @map("coverage_district_codes")
  latitude         Float?
  longitude        Float?
  priceNote        String?  @map("price_note")
  widthM           Float?   @map("width_m")
  heightM          Float?   @map("height_m")
  resolution       String?
  operatingHours   String?  @map("operating_hours")
  dailyFootfall    Int?     @map("daily_footfall")
  weekdayFootfall  Int?     @map("weekday_footfall")
  targetAge        String?  @map("target_age")
  impressions      Int?
  reach            Float?
  frequency        Float?
  cpm              Float?
  engagementRate   Float?   @map("engagement_rate")
  visibilityScore  Int      @default(0) @map("visibility_score")
  /// 설치 연도 (옵션, 공개 검색 고급 필터)
  installYear      Int?     @map("install_year")
  effectMemo       String?  @map("effect_memo")
  /// 시간대(24)·요일(7)·월(12) 유동인구 패턴. nullable — 미입력 시 추정 사용.
  /// shape: { hourly: number[24], weekly: number[7], monthly: number[12], updatedAt?: ISO }
  trafficPattern   Json?    @map("traffic_pattern")
  extractedImages  String[] @default([]) @map("extracted_images")
  /** 광고주 이력 (쉼표 구분). 비어 있으면 집행 이력(MediaAdvertiserExecution)에서 요약 */
  pastAdvertisers  String?  @map("past_advertisers")
  /** 주변 시설 (쉼표 구분). 자동 수집·수동 입력 */
  nearbyFacilities String?  @map("nearby_facilities")
  /** 가까운 지하철역 목록(자동·수정) */
  nearbyStations   String?  @map("nearby_stations")
  /** 백화점·대학·관광 등 랜드마크 요약 */
  nearbyLandmarks  String?  @map("nearby_landmarks")
  /** 카카오 주소검색 등으로 좌표·행정구역이 확인된 경우 */
  addressVerified  Boolean  @default(false) @map("address_verified")
  /** 운영이 공개 카탈로그에 THINKAD Verified 리본을 붙일지 (관리자 수동) */
  isVerified       Boolean  @default(false) @map("is_verified")
  /** 주변 시설 등 자동 수집이 수행된 시각 */
  autoPopulatedAt  DateTime? @map("auto_populated_at")

  availability MediaAvailability @default(available) @map("availability")
  isActive     Boolean           @default(true) @map("is_active")
  /// 홈(`page.tsx`) 추천 영역 — `fetchHomeFeaturedMedia`가 `isFeatured=true` 우선 조회
  isFeatured    Boolean @default(false) @map("is_featured")
  /// 홈 추천 정렬: 오름차순, null은 뒤로
  featuredOrder Int?    @map("featured_order")

  /// 홈 인기 매체 영역 — `fetchHomePopularMedia`가 `isPopular=true` 우선 조회 (추천과 독립)
  isPopular     Boolean @default(false) @map("is_popular")
  /// 홈 인기 정렬: 오름차순, null은 뒤로
  popularOrder  Int?    @map("popular_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  priceSnapshots        MediaPriceSnapshot[]
  bookings              MediaBooking[]
  advertiserExecutions  MediaAdvertiserExecution[]

  /// 네트워크 패키지 내 개별 지점과의 연결 (선택)
  networkLocations MediaNetworkLocation[]

  @@index([isFeatured, featuredOrder])
  @@index([isPopular, popularOrder])
  @@map("media")
}

model MediaPriceSnapshot {
  id            String   @id @default(cuid())
  mediaId       String   @map("media_id")
  price         Int
  note          String?
  effectiveFrom DateTime @default(now()) @map("effective_from")

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@map("media_price_snapshots")
}

model MediaBooking {
  id                String              @id @default(cuid())
  mediaId           String              @map("media_id")
  title             String
  startsAt          DateTime            @map("starts_at")
  endsAt            DateTime            @map("ends_at")
  /// 기본값 tentative — 운영자가 직접 만드는 슬롯은 가홀드부터.
  /// 광고주 자가 신청은 API 에서 명시적으로 requested 로 생성.
  status            MediaBookingStatus  @default(tentative)
  campaignId        String?             @map("campaign_id")
  notes             String?

  /// 광고주 자가 신청 추적 — 가입 사용자
  requestedByUserId String?             @map("requested_by_user_id")
  /// 익명 신청 시 연락처 (가입 사용자면 User 테이블 참조 우선)
  requesterName     String?             @map("requester_name")
  requesterEmail    String?             @map("requester_email")
  requesterPhone    String?             @map("requester_phone")
  /// 광고주가 입력한 희망 예산 (₩)
  budgetWon         Int?                @map("budget_won")
  /// 어드민이 status 결정한 시각 (requested → tentative/confirmed/cancelled)
  decidedAt         DateTime?           @map("decided_at")
  decidedByAdminId  String?             @map("decided_by_admin_id")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt       @map("updated_at")

  media       Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  requestedBy User?     @relation("BookingRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  /// 충돌 쿼리(특정 매체 + 활성 status) 빈번 → 복합 인덱스
  @@index([mediaId, status])
  @@index([startsAt, endsAt])
  @@index([requestedByUserId])
  @@map("media_bookings")
}

model MediaAdvertiserExecution {
  id             String    @id @default(cuid())
  mediaId        String    @map("media_id")
  advertiserName String    @map("advertiser_name")
  campaignLabel  String?   @map("campaign_label")
  periodStart    DateTime? @map("period_start")
  periodEnd      DateTime? @map("period_end")
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at")

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@map("media_advertiser_executions")
}

model CrmAccount {
  id        String   @id @default(cuid())
  email     String   @unique
  company   String
  name      String
  phone     String?
  tier      CrmTier  @default(standard)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  campaigns   Campaign[]
  contactLogs CrmContactLog[]
  notes       CrmNote[]
  followUps   CrmFollowUp[]

  @@map("crm_accounts")
}

model CrmContactLog {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  channel   String
  summary   String
  createdAt DateTime @default(now()) @map("created_at")

  account CrmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("crm_contact_logs")
}

model CrmNote {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account CrmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("crm_notes")
}

model CrmFollowUp {
  id               String    @id @default(cuid())
  accountId        String    @map("account_id")
  title            String
  dueAt            DateTime  @map("due_at")
  doneAt           DateTime? @map("done_at")
  remindEmail      String?   @map("remind_email")
  reminderSentAt   DateTime? @map("reminder_sent_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  account CrmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([dueAt])
  @@map("crm_follow_ups")
}

model Campaign {
  id            String          @id @default(cuid())
  name          String
  clientCompany String          @map("client_company")
  clientName    String          @map("client_name")
  clientEmail   String          @map("client_email")
  clientPhone   String?         @map("client_phone")
  status        CampaignStatus  @default(proposal)
  budgetMin     Int?            @map("budget_min")
  budgetMax     Int?            @map("budget_max")
  startDate     DateTime?       @map("start_date")
  endDate       DateTime?       @map("end_date")
  notes         String?
  accountId     String?         @map("account_id")
  completionReportUrl         String?   @map("completion_report_url")
  completionReportGeneratedAt DateTime? @map("completion_report_generated_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  account         CrmAccount?             @relation(fields: [accountId], references: [id], onDelete: SetNull)
  scheduleEvents  CampaignScheduleEvent[]
  financialDocs   CampaignFinancialDoc[]
  mediaBookings   MediaBooking[]
  quoteRequests   QuoteRequest[]
  proofPhotos     CampaignProofPhoto[]
  successCase     SuccessCase?
  oohQuote        OoHQuote?

  @@index([status])
  @@map("campaigns")
}

model CampaignProofPhoto {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  imageUrl   String   @map("image_url")
  caption    String?
  createdAt  DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("campaign_proof_photos")
}

model CampaignScheduleEvent {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  title      String
  startsAt   DateTime @map("starts_at")
  endsAt     DateTime @map("ends_at")
  kind       String   @default("broadcast")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([startsAt])
  @@map("campaign_schedule_events")
}

model CampaignFinancialDoc {
  id          String             @id @default(cuid())
  campaignId  String             @map("campaign_id")
  kind        FinancialDocKind
  title       String
  amountKrw   Int?               @map("amount_krw")
  status      FinancialDocStatus @default(draft)
  dueDate     DateTime?          @map("due_date")
  documentUrl String?            @map("document_url")
  paidAt      DateTime?          @map("paid_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([dueDate])
  @@index([kind, status])
  @@map("campaign_financial_docs")
}

model QuoteTemplate {
  id         String   @id @default(cuid())
  name       String
  headerHtml String?  @map("header_html")
  footerHtml String?  @map("footer_html")
  bodyHtml   String   @map("body_html")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("quote_templates")
}

model ContactInquiry {
  id        String   @id @default(cuid())
  company   String
  name      String
  phone     String
  email     String?
  inquiryType String?  @map("inquiry_type")
  budget    String?
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_inquiries")
}

model CustomerFeedback {
  id        String   @id @default(cuid())
  email     String
  answers   Json     @map("answers")
  coupon    String   @unique @map("coupon_code")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("customer_feedback")
}

model CaseStudy {
  id            String   @id @default(cuid())
  title         String
  titleEn       String?  @map("title_en")
  description   String
  descriptionEn String?  @map("description_en")
  category      String
  image         String?
  client        String?
  results       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("case_studies")
}

model QuoteRequest {
  id            String   @id @default(cuid())
  company       String
  name          String
  phone         String
  email         String?
  mediaIds      String   @map("media_ids")
  period        String?
  budgetMin     Int?     @map("budget_min")
  budgetMax     Int?     @map("budget_max")
  estimatedCost Int?     @map("estimated_cost")
  message       String?
  status        String   @default("pending")
  region        String?
  campaignId    String?  @map("campaign_id")
  createdAt     DateTime @default(now()) @map("created_at")

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  oohQuote OoHQuote?

  @@index([campaignId])
  @@map("quote_requests")
}

/// 공개 견적·부킹·계약 파이프라인 (`/quote`, `/quote/[id]`)
model OoHQuote {
  id     String         @id @default(cuid())
  status OoHQuoteStatus @default(draft)

  clientName    String  @map("client_name")
  clientEmail   String  @map("client_email")
  clientPhone   String? @map("client_phone")
  clientCompany String? @map("client_company")

  mediaIds    String[] @map("media_ids")
  totalAmount Int      @map("total_amount")
  period      String
  periodKey   String?  @map("period_key")
  budgetMin   Int?     @map("budget_min")
  budgetMax   Int?     @map("budget_max")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")

  bookingRequestedAt  DateTime? @map("booking_requested_at")
  bookingConfirmedAt  DateTime? @map("booking_confirmed_at")
  invoiceSentAt       DateTime? @map("invoice_sent_at")
  paymentAmount       Int?      @map("payment_amount")
  paymentConfirmedAt  DateTime? @map("payment_confirmed_at")
  contractConfirmedAt DateTime? @map("contract_confirmed_at")

  adminNote    String? @map("admin_note")
  cancelReason String? @map("cancel_reason")
  pdfTemplate  String  @default("default") @map("pdf_template")
  locale       String  @default("ko")
  quotePdfSentAt DateTime? @map("quote_pdf_sent_at")
  contractDocUrl String? @map("contract_doc_url")
  invoiceDocUrl  String? @map("invoice_doc_url")

  campaignId String?   @unique @map("campaign_id")
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  quoteRequestId String?      @unique @map("quote_request_id")
  quoteRequest   QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)

  /** 네트워크 매체 선택 시 [{ networkId, units, regions, lineTotal만원 }] */
  networkSelections Json? @map("network_selections")

  oohContract OohContract?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("ooh_quotes")
}

/// 버스쉘터·아파트 등 다지점 패키지 매체
model MediaNetwork {
  id          String  @id @default(cuid())
  name        String
  nameEn      String? @map("name_en")
  description String? @db.Text
  /// bus_shelter | apartment | subway_pillar | convenience_store | golf_course | highway_rest | subway_digital_square_pillar
  type        String

  pricePerUnit   Int?    @map("price_per_unit")
  pricePackage   Int?    @map("price_package")
  priceNote      String? @map("price_note") @db.Text
  minUnits       Int     @default(1) @map("min_units")

  totalLocations Int      @map("total_locations")
  regions        String[] @default([])
  city           String?
  district       String?

  image         String?
  galleryImages String[] @default([]) @map("gallery_images")
  features      String?  @db.Text
  /// [{ "units": 100, "price": 5000 }, ...] 만원 단위
  packageOptions Json?   @map("package_options")

  visibilityScore Int?    @map("visibility_score")
  dailyFootfall   Int?    @map("daily_footfall")
  targetAge       String? @map("target_age")
  effectMemo      String? @map("effect_memo") @db.Text
  operatingHours  String? @map("operating_hours")
  tags            String[] @default([])

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  locations MediaNetworkLocation[]

  @@index([isActive, type])
  @@map("media_networks")
}

model MediaNetworkLocation {
  id        String       @id @default(cuid())
  networkId String       @map("network_id")
  network   MediaNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)

   /// 연결된 단일 매체 (선택). 없으면 네트워크 전용 지점으로 취급
  mediaId String? @map("media_id")
  media   Media?  @relation(fields: [mediaId], references: [id])

  name          String
  address       String?
  fullAddress   String? @map("full_address")
  latitude      Float?
  longitude     Float?
  priceNote     String? @map("price_note") @db.Text
  dailyFootfall Int?    @map("daily_footfall")
  note          String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([networkId])
  @@index([mediaId])
  @@map("media_network_locations")
}

/// OOH 표준 계약서 + 전자서명 (OoHQuote 1:1)
model OohContract {
  id         String @id @default(cuid())
  ooHQuoteId String @unique @map("ooh_quote_id")
  ooHQuote   OoHQuote @relation(fields: [ooHQuoteId], references: [id], onDelete: Cascade)

  /** 서명 완료 PDF (Base64). 공개 다운로드는 API에서 제공 */
  signedPdfBase64 String? @map("signed_pdf_base64") @db.Text
  /** 감사용: inline | cloud URL 확장 시 */
  contractPdfUrl String @default("") @map("contract_pdf_url")

  signedAt       DateTime? @map("signed_at")
  signerName     String?   @map("signer_name")
  signerEmail    String?   @map("signer_email")
  signerIp       String?   @map("signer_ip")
  signerAgent    String?   @map("signer_agent") @db.Text
  signatureImage String?   @map("signature_image") @db.Text
  agreementAcceptedAt DateTime? @map("agreement_accepted_at")

  documentSha256 String? @map("document_sha256")
  specialTerms   String? @map("special_terms") @db.Text

  status OohContractStatus @default(pending)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("ooh_contracts")
}

/** 관리자 견적(정규화 라인 아이템) */
model Quote {
  id          String   @id @default(cuid())
  quoteNumber String   @unique @map("quote_number")
  /** draft | sent | contracted | expired */
  status      String   @default("draft")
  clientName  String   @map("client_name")
  clientEmail String?  @map("client_email")
  clientPhone String?  @map("client_phone")
  validUntil  DateTime @map("valid_until")
  subtotal    Int
  discount    Int      @default(0)
  tax         Int      @default(0)
  total       Int
  items       QuoteItem[]
  sentAt      DateTime? @map("sent_at")
  isKo        Boolean  @default(true) @map("is_ko")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("quotes")
}

model QuoteItem {
  id        String  @id @default(cuid())
  quoteId   String  @map("quote_id")
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  mediaId   String? @map("media_id")
  mediaName String  @map("media_name")
  spec      String? @map("spec")
  period    String  @map("period")
  unitPrice Int     @map("unit_price")
  quantity  Int     @default(1)
  amount    Int     @map("amount")

  @@index([quoteId])
  @@map("quote_items")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

enum AnalyticsIntegrationProvider {
  ga4
  gtm
}

model AnalyticsIntegration {
  id            String                       @id @default(cuid())
  provider      AnalyticsIntegrationProvider @unique
  enabled       Boolean                      @default(false)
  measurementId String?                      @map("measurement_id")
  containerId   String?                      @map("container_id")
  notes         String?                      @db.Text
  createdAt     DateTime                     @default(now()) @map("created_at")
  updatedAt     DateTime                     @updatedAt @map("updated_at")

  @@index([enabled])
  @@map("analytics_integrations")
}

model TrendReport {
  id                 String    @id @default(cuid())
  month              String?   @unique
  slug               String?   @unique
  status             String    @default("draft")
  titleKo            String    @map("title_ko")
  titleEn            String?   @map("title_en")
  contentKo          String    @map("content_ko") @db.Text
  summaryKo          String[]  @map("summary_ko")
  marketTrendKo      String[]  @map("market_trend_ko")
  doohTrendKo        String[]  @map("dooh_trend_ko")
  verticalStrategies Json?     @map("vertical_strategies")
  thumbnailUrl       String?   @map("thumbnail_url")
  publishedAt        DateTime? @map("published_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  generationMethod   String    @default("manual") @map("generation_method")
  aiModel            String?   @map("ai_model")
  /// Tavily 등 웹 검색에서 인용한 출처 [{title, url, snippet, domain, publishedAt?, trustGrade?}]
  sources            Json?     @default("[]")
  /// generator 가 참고한 자체 매체 DB 인사이트 라벨 ("지역별 매체 분포 TOP 5" 등)
  internalDataUsed   String[]  @default([]) @map("internal_data_used")
  /// PR-3 자동 검증 점수 (0~100). null = 미검증
  validationScore    Int?      @map("validation_score")
  /// PR-3 자동 검증 결과 ({verdict, scores, issues[], shouldPublish, requiresHumanReview, validatedAt, modelUsed})
  validationResult   Json?     @map("validation_result")

  @@map("trend_reports")
}

model SuccessCase {
  id             String    @id @default(cuid())
  campaignId     String?   @unique @map("campaign_id")
  campaign       Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  status         String    @default("draft")
  clientName     String    @map("client_name")
  industry       String
  titleKo        String    @map("title_ko")
  titleEn        String?   @map("title_en")
  summaryKo      String    @map("summary_ko")
  challengeKo    String    @map("challenge_ko") @db.Text
  solutionKo     String    @map("solution_ko") @db.Text
  resultsKo      String[]  @map("results_ko")
  metricsJson    Json?     @map("metrics_json")
  /// 카테고리 텍스트 (예: "빌보드", "디지털 사이니지"). 운영팀 입력 라벨.
  mediaUsed      String[]  @map("media_used")
  /// 실제 매체 ID(`Media.id`) 배열. 매체 상세 ↔ 사례 양방향 연결용. 빈배열이면 양방향 연결 없음.
  mediaIds       String[]  @default([]) @map("media_ids")
  periodStart    DateTime? @map("period_start")
  periodEnd      DateTime? @map("period_end")
  thumbnailUrl   String?   @map("thumbnail_url")
  galleryUrls    String[]  @default([]) @map("gallery_urls")
  testimonialKo  String?   @map("testimonial_ko") @db.Text
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([publishedAt])
  @@map("success_cases")
}

model AcademyLesson {
  id             String    @id @default(cuid())
  courseId       String    @map("course_id")
  order          Int       @map("lesson_order")
  status         String    @default("draft")
  titleKo        String    @map("title_ko")
  titleEn        String?   @map("title_en")
  descriptionKo  String    @map("description_ko")
  objectivesKo   String[]  @map("objectives_ko")
  chapters       Json      @map("chapters")
  quizzes        Json?     @map("quizzes")
  durationMin    Int       @default(15) @map("duration_min")
  thumbnailUrl   String?   @map("thumbnail_url")
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([courseId, order])
  @@map("academy_lessons")
}

/// type: trend_report | academy_lesson | success_case | campaign_report | campaign_completion_pdf
model GenerationLog {
  id         String   @id @default(cuid())
  type       String
  targetId   String?  @map("target_id")
  prompt     String   @db.Text
  response   String?  @db.Text
  model      String   @map("model_name")
  tokensUsed Int?     @map("tokens_used")
  status     String
  errorMsg   String?  @map("error_msg")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@map("generation_logs")
}

enum AppUserRole {
  advertiser
  agency
  owner
  admin
}

enum CommunityMemberRole {
  ADVERTISER
  MEDIA
  AGENCY
  FREELANCER
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  name            String
  phone           String?
  company         String?
  locale          String    @default("ko")
  role            AppUserRole @default(advertiser)
  communityRole   CommunityMemberRole? @map("community_role")
  communityBio    String?   @map("community_bio")
  /** 커뮤니티 멤버 디렉터리·프로필용 지역 (서울/부산/대구 등) */
  region            String?   @map("region")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions        UserSession[]
  bookingRequests MediaBooking[] @relation("BookingRequester")
  communityPosts      CommunityPost[]     @relation("CommunityPostAuthor")
  communityComments   CommunityComment[]  @relation("CommunityCommentAuthor")
  communityPostLikes  CommunityPostLike[]
  communityBookmarks  CommunityBookmark[]

  @@index([email])
  @@map("users")
}

model UserSession {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ip        String?
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// 공개 플래너 저장·공유 플랜. 30일 후 자동 만료.
model SavedPlannerPlan {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  /** 저장 시 선택적으로 입력. 재편집·이메일 재전송 플로우에 활용 */
  userEmail String?  @map("user_email")
  /** PlannerStore partialize 결과 그대로 직렬화된 입력 상태 전체 */
  planJson  Json     @map("plan_json")
  viewCount Int      @default(0) @map("view_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("saved_planner_plans")
}

model UserFavoriteMedia {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  mediaId   String   @map("media_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, mediaId])
  @@index([mediaId])
  @@map("user_favorite_medias")
}

// ── Community (Phase 3a) ─────────────────────────────────────────
// 광고주 / 매체사 / 마케터 간 Q&A · 매체 후기 · 매체 추천 게시판.
// 익명 + 가입 사용자 모두 작성 가능 (Turnstile 으로 스팸 차단).
// 신고 누적 시 자동 hidden, 어드민이 검토 후 published / deleted 결정.

model CommunityPost {
  id          String   @id @default(cuid())
  category    String   // "insight" | "qna" | "networking" | "review"
  title       String   @db.VarChar(200)
  body        String   @db.Text
  authorName  String   @map("author_name") @db.VarChar(50)
  /** 가입 사용자 글일 때 User.id, 익명일 때 null */
  authorUserId String? @map("author_user_id")
  /** 본문 내 노출 안 함 — 어드민 검토 / 답변 통보용 */
  authorEmail String?  @map("author_email")
  isAnonymous Boolean  @default(false) @map("is_anonymous")
  /** 작성 IP (rate limit / 신고 추적용, 일정 기간 후 익명화 가능) */
  authorIp    String?  @map("author_ip")
  status      String   @default("published") // published | hidden | deleted
  reportCount Int      @default(0) @map("report_count")
  likeCount   Int      @default(0) @map("like_count")
  viewCount   Int      @default(0) @map("view_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  authorUser  User?    @relation("CommunityPostAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  comments    CommunityComment[]
  likes       CommunityPostLike[]
  bookmarks   CommunityBookmark[]

  @@index([category, status, createdAt])
  @@index([status, createdAt])
  @@index([authorUserId])
  @@map("community_posts")
}

model CommunityComment {
  id          String   @id @default(cuid())
  postId      String   @map("post_id")
  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  body        String   @db.Text
  authorName  String   @map("author_name") @db.VarChar(50)
  authorUserId String? @map("author_user_id")
  authorEmail String?  @map("author_email")
  isAnonymous Boolean  @default(false) @map("is_anonymous")
  authorIp    String?  @map("author_ip")
  status      String   @default("published") // published | hidden | deleted
  reportCount Int      @default(0) @map("report_count")
  createdAt   DateTime @default(now()) @map("created_at")
  authorUser  User?    @relation("CommunityCommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([postId, status, createdAt])
  @@index([authorUserId])
  @@map("community_comments")
}

model CommunityReport {
  id         String   @id @default(cuid())
  /** "post" | "comment" */
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  reason     String   @db.Text
  reporterIp String?  @map("reporter_ip")
  reporterUserId String? @map("reporter_user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("community_reports")
}

model CommunityPostLike {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  /** 가입 사용자 likeId, 익명은 ipHash */
  userId    String?  @map("user_id")
  ipHash    String?  @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at")

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([postId, userId], name: "post_user_unique")
  @@unique([postId, ipHash], name: "post_ip_unique")
  @@index([postId])
  @@map("community_post_likes")
}

model CommunityBookmark {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId], name: "post_bookmark_user_unique")
  @@index([postId])
  @@index([userId])
  @@map("community_bookmarks")
}

// ── Public trend reports (/[locale]/report) ─────────────────────

enum ReportCategory {
  TREND
  MEDIA
  GUIDE
  REGION
  CAMPAIGN
}

model Report {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  summary     String         @db.Text
  content     String         @db.Text
  category    ReportCategory
  tags        String[]       @default([])
  thumbnail   String?
  published   Boolean        @default(false) @map("published")
  publishedAt DateTime?      @map("published_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([published, category, publishedAt])
  @@map("reports")
}
