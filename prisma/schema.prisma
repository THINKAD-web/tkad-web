  firstSeenAt       DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt        DateTime  @updatedAt @map("last_seen_at")
  signedUpAt        DateTime? @map("signed_up_at")
  quoteRequestedAt  DateTime? @map("quote_requested_at")
  guideDownloadedAt DateTime? @map("guide_downloaded_at")
  quickQuoteAt      DateTime? @map("quick_quote_at")
  budgetPreviewAt   DateTime? @map("budget_preview_at")

  steps VisitorJourneyStep[]

  @@index([firstSeenAt(sort: Desc)])
  @@index([utmSource, firstSeenAt(sort: Desc)])
  @@map("visitor_journeys")
}

model VisitorJourneyStep {
  id        String   @id @default(cuid())
  journeyId String   @map("journey_id")
  step      String   @db.VarChar(64)
  path      String?  @db.VarChar(500)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  journey VisitorJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId, createdAt(sort: Asc)])
  @@index([step, createdAt(sort: Desc)])
  @@map("visitor_journey_steps")
}

// ── Ops monitoring (PageView, ConversionEvent) ─────────────────

enum ConversionEventType {
  visit
  media_view
  favorite
  quote_request
  contract
}

/// 공개 사이트 페이지뷰 (익명 sessionId)
model PageView {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  path      String
  locale    String?
  referrer  String?
  userAgent String?  @map("user_agent") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId, createdAt(sort: Desc)])
  @@index([path, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("page_views")
}

/// 전환 퍼널 이벤트
model ConversionEvent {
  id        String              @id @default(cuid())
  sessionId String?             @map("session_id")
  type      ConversionEventType
  path      String?
  mediaId   String?             @map("media_id")
  userId    String?             @map("user_id")
  metadata  Json?
  createdAt DateTime            @default(now()) @map("created_at")

  @@index([type, createdAt(sort: Desc)])
  @@index([mediaId, type, createdAt(sort: Desc)])
  @@index([sessionId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("conversion_events")
}

/// API 500 등 운영 에러 로그
model OpsErrorLog {
  id        String   @id @default(cuid())
  tag       String?
  path      String?
  status    Int      @default(500)
  message   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("ops_error_logs")
}

/// 일일 논리 DB 스냅샷(행 수) — Neon PITR 보완
model OpsBackupRun {
  id        String   @id @default(cuid())
  status    String   @db.VarChar(16)
  detail    String?  @db.VarChar(512)
  snapshot  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("ops_backup_runs")
}

/// B2B 공개 API 키 (대행사·파트너 연동) — 평문 key는 keyHash(SHA-256)에만 저장
model ApiKey {
  id           String     @id @default(cuid())
  userId       String     @map("user_id")
  name         String     @db.VarChar(80)
  keyHash      String     @unique @map("key_hash")
  keyPrefix    String     @map("key_prefix") @db.VarChar(24)
  keyLast4     String     @default("") @map("key_last4") @db.VarChar(4)
  plan         ApiKeyPlan @default(FREE)
  requestCount Int        @default(0) @map("request_count")
  usageMonth   String     @default("") @map("usage_month") @db.VarChar(7)
  lastUsedAt   DateTime?  @map("last_used_at")
  lastBurstAlertAt DateTime? @map("last_burst_alert_at")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageLogs ApiUsageLog[]

  @@index([userId])
  @@index([isActive])
  @@map("api_keys")
}

/// 공개 API 호출 로그 (ApiRequestLog — 어드민 모니터링·이상 트래픽 감지)
model ApiUsageLog {
  id        String   @id @default(cuid())
  apiKeyId  String   @map("api_key_id")
  endpoint  String   @db.VarChar(256)
  method    String   @db.VarChar(8)
  status    Int
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId, createdAt(sort: Desc)])
  @@index([endpoint, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("api_usage_logs")
}

/// AI·플래너 매체 추천 요청 로그
model RecommendationLog {
  id                  String   @id @default(cuid())
  userId              String?  @map("user_id")
  sessionId           String?  @map("session_id") @db.VarChar(64)
  source              String   @db.VarChar(32)
  input               Json
  recommendations     Json
  selectedMediaIds    String[] @default([]) @map("selected_media_ids")
  convertedToInquiry  Boolean  @default(false) @map("converted_to_inquiry")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([source, createdAt(sort: Desc)])
  @@map("recommendation_logs")
}

/// OOH 패키지 큐레이션 — 동적 필터로 매체 자동 매칭
model MediaPackage {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  subtitle    String
  description String   @db.Text
  heroColor   String   @map("hero_color")
  icon        String
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")

  filterRegion   String[] @default([]) @map("filter_region")
  filterCategory String[] @default([]) @map("filter_category")
  filterTarget   String[] @default([]) @map("filter_target")
  filterMaxPrice Int?     @map("filter_max_price")
  filterMinPrice Int?     @map("filter_min_price")
  sortBy         String   @default("popular") @map("sort_by")

  badgeText      String?  @map("badge_text")
  guideSteps     Json?    @map("guide_steps")
  faqs           Json?
  targetIndustry String[] @default([]) @map("target_industry")
  avgBudget      String?  @map("avg_budget")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, order])
  @@map("media_packages")
}
