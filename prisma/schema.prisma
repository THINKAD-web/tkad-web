generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CampaignStatus {
  proposal
  negotiation
  contract
  production
  airing
  completed
}

enum MediaAvailability {
  available
  reserved
  maintenance
}

enum CrmTier {
  vip
  standard
  lead
}

enum FinancialDocKind {
  quote
  contract
  invoice
}

enum FinancialDocStatus {
  draft
  sent
  paid
  overdue
  cancelled
}

/// 고객 /quote 파이프라인 (관리자 정식 Quote `quotes` 테이블과 별도)
enum OoHQuoteStatus {
  draft
  sent
  booking_requested
  booking_pending
  booking_confirmed
  invoice_sent
  payment_pending
  payment_confirmed
  contract_confirmed
  in_progress
  completed
  cancelled
}

/// 전자계약 (`/quote/[id]/contract`) — 관리자 Quote와 무관
enum OohContractStatus {
  pending
  signed
  confirmed
  cancelled
}

model Media {
  id        String   @id @default(cuid())
  name      String
  nameEn    String?  @map("name_en")
  location  String
  region    String
  /// Catalog code: `digital` | `static` | `mobile` (OOH 유형)
  type      String
  price     Int
  image     String?
  width     String?
  height    String?

  description      String?
  subCategory      String?  @map("sub_category")
  tags             String[] @default([])
  district         String?
  city             String?
  latitude         Float?
  longitude        Float?
  priceNote        String?  @map("price_note")
  widthM           Float?   @map("width_m")
  heightM          Float?   @map("height_m")
  resolution       String?
  operatingHours   String?  @map("operating_hours")
  dailyFootfall    Int?     @map("daily_footfall")
  weekdayFootfall  Int?     @map("weekday_footfall")
  targetAge        String?  @map("target_age")
  impressions      Int?
  reach            Float?
  frequency        Float?
  cpm              Float?
  engagementRate   Float?   @map("engagement_rate")
  visibilityScore  Int      @default(0) @map("visibility_score")
  /// 설치 연도 (옵션, 공개 검색 고급 필터)
  installYear      Int?     @map("install_year")
  effectMemo       String?  @map("effect_memo")
  extractedImages  String[] @default([]) @map("extracted_images")
  /** 광고주 이력 (쉼표 구분). 비어 있으면 집행 이력(MediaAdvertiserExecution)에서 요약 */
  pastAdvertisers  String?  @map("past_advertisers")
  /** 주변 시설 (쉼표 구분). 자동 수집·수동 입력 */
  nearbyFacilities String?  @map("nearby_facilities")
  /** 가까운 지하철역 목록(자동·수정) */
  nearbyStations   String?  @map("nearby_stations")
  /** 백화점·대학·관광 등 랜드마크 요약 */
  nearbyLandmarks  String?  @map("nearby_landmarks")
  /** 카카오 주소검색 등으로 좌표·행정구역이 확인된 경우 */
  addressVerified  Boolean  @default(false) @map("address_verified")
  /** 주변 시설 등 자동 수집이 수행된 시각 */
  autoPopulatedAt  DateTime? @map("auto_populated_at")

  availability MediaAvailability @default(available) @map("availability")
  isActive     Boolean           @default(true) @map("is_active")
  /// 홈(`page.tsx`) 추천 영역 — `fetchHomeFeaturedMedia`가 `isFeatured=true` 우선 조회
  isFeatured    Boolean @default(false) @map("is_featured")
  /// 홈 추천 정렬: 오름차순, null은 뒤로
  featuredOrder Int?    @map("featured_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  priceSnapshots        MediaPriceSnapshot[]
  bookings              MediaBooking[]
  advertiserExecutions  MediaAdvertiserExecution[]

  @@index([isFeatured, featuredOrder])
  @@map("media")
}

model MediaPriceSnapshot {
  id            String   @id @default(cuid())
  mediaId       String   @map("media_id")
  price         Int
  note          String?
  effectiveFrom DateTime @default(now()) @map("effective_from")

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@map("media_price_snapshots")
}

model MediaBooking {
  id         String    @id @default(cuid())
  mediaId    String    @map("media_id")
  title      String
  startsAt   DateTime  @map("starts_at")
  endsAt     DateTime  @map("ends_at")
  status     String    @default("hold")
  campaignId String?   @map("campaign_id")
  notes      String?

  media    Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([mediaId])
  @@index([startsAt, endsAt])
  @@map("media_bookings")
}

model MediaAdvertiserExecution {
  id             String    @id @default(cuid())
  mediaId        String    @map("media_id")
  advertiserName String    @map("advertiser_name")
  campaignLabel  String?   @map("campaign_label")
  periodStart    DateTime? @map("period_start")
  periodEnd      DateTime? @map("period_end")
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at")

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@map("media_advertiser_executions")
}

model CrmAccount {
  id        String   @id @default(cuid())
  email     String   @unique
  company   String
  name      String
  phone     String?
  tier      CrmTier  @default(standard)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  campaigns   Campaign[]
  contactLogs CrmContactLog[]
  notes       CrmNote[]
  followUps   CrmFollowUp[]

  @@map("crm_accounts")
}

model CrmContactLog {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  channel   String
  summary   String
  createdAt DateTime @default(now()) @map("created_at")

  account CrmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("crm_contact_logs")
}

model CrmNote {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account CrmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("crm_notes")
}

model CrmFollowUp {
  id               String    @id @default(cuid())
  accountId        String    @map("account_id")
  title            String
  dueAt            DateTime  @map("due_at")
  doneAt           DateTime? @map("done_at")
  remindEmail      String?   @map("remind_email")
  reminderSentAt   DateTime? @map("reminder_sent_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  account CrmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([dueAt])
  @@map("crm_follow_ups")
}

model Campaign {
  id            String          @id @default(cuid())
  name          String
  clientCompany String          @map("client_company")
  clientName    String          @map("client_name")
  clientEmail   String          @map("client_email")
  clientPhone   String?         @map("client_phone")
  status        CampaignStatus  @default(proposal)
  budgetMin     Int?            @map("budget_min")
  budgetMax     Int?            @map("budget_max")
  startDate     DateTime?       @map("start_date")
  endDate       DateTime?       @map("end_date")
  notes         String?
  accountId     String?         @map("account_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  account         CrmAccount?             @relation(fields: [accountId], references: [id], onDelete: SetNull)
  scheduleEvents  CampaignScheduleEvent[]
  financialDocs   CampaignFinancialDoc[]
  mediaBookings   MediaBooking[]
  quoteRequests   QuoteRequest[]
  proofPhotos     CampaignProofPhoto[]
  successCase     SuccessCase?
  oohQuote        OoHQuote?

  @@index([status])
  @@map("campaigns")
}

model CampaignProofPhoto {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  imageUrl   String   @map("image_url")
  caption    String?
  createdAt  DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("campaign_proof_photos")
}

model CampaignScheduleEvent {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  title      String
  startsAt   DateTime @map("starts_at")
  endsAt     DateTime @map("ends_at")
  kind       String   @default("broadcast")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([startsAt])
  @@map("campaign_schedule_events")
}

model CampaignFinancialDoc {
  id          String             @id @default(cuid())
  campaignId  String             @map("campaign_id")
  kind        FinancialDocKind
  title       String
  amountKrw   Int?               @map("amount_krw")
  status      FinancialDocStatus @default(draft)
  dueDate     DateTime?          @map("due_date")
  documentUrl String?            @map("document_url")
  paidAt      DateTime?          @map("paid_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([dueDate])
  @@index([kind, status])
  @@map("campaign_financial_docs")
}

model QuoteTemplate {
  id         String   @id @default(cuid())
  name       String
  headerHtml String?  @map("header_html")
  footerHtml String?  @map("footer_html")
  bodyHtml   String   @map("body_html")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("quote_templates")
}

model ContactInquiry {
  id        String   @id @default(cuid())
  company   String
  name      String
  phone     String
  email     String?
  budget    String?
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_inquiries")
}

model CustomerFeedback {
  id        String   @id @default(cuid())
  email     String
  answers   Json     @map("answers")
  coupon    String   @unique @map("coupon_code")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("customer_feedback")
}

model CaseStudy {
  id            String   @id @default(cuid())
  title         String
  titleEn       String?  @map("title_en")
  description   String
  descriptionEn String?  @map("description_en")
  category      String
  image         String?
  client        String?
  results       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("case_studies")
}

model QuoteRequest {
  id            String   @id @default(cuid())
  company       String
  name          String
  phone         String
  email         String?
  mediaIds      String   @map("media_ids")
  period        String?
  budgetMin     Int?     @map("budget_min")
  budgetMax     Int?     @map("budget_max")
  estimatedCost Int?     @map("estimated_cost")
  message       String?
  status        String   @default("pending")
  region        String?
  campaignId    String?  @map("campaign_id")
  createdAt     DateTime @default(now()) @map("created_at")

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  oohQuote OoHQuote?

  @@index([campaignId])
  @@map("quote_requests")
}

/// 공개 견적·부킹·계약 파이프라인 (`/quote`, `/quote/[id]`)
model OoHQuote {
  id     String         @id @default(cuid())
  status OoHQuoteStatus @default(draft)

  clientName    String  @map("client_name")
  clientEmail   String  @map("client_email")
  clientPhone   String? @map("client_phone")
  clientCompany String? @map("client_company")

  mediaIds    String[] @map("media_ids")
  totalAmount Int      @map("total_amount")
  period      String
  periodKey   String?  @map("period_key")
  budgetMin   Int?     @map("budget_min")
  budgetMax   Int?     @map("budget_max")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")

  bookingRequestedAt  DateTime? @map("booking_requested_at")
  bookingConfirmedAt  DateTime? @map("booking_confirmed_at")
  invoiceSentAt       DateTime? @map("invoice_sent_at")
  paymentAmount       Int?      @map("payment_amount")
  paymentConfirmedAt  DateTime? @map("payment_confirmed_at")
  contractConfirmedAt DateTime? @map("contract_confirmed_at")

  adminNote    String? @map("admin_note")
  cancelReason String? @map("cancel_reason")
  pdfTemplate  String  @default("default") @map("pdf_template")
  locale       String  @default("ko")
  quotePdfSentAt DateTime? @map("quote_pdf_sent_at")
  contractDocUrl String? @map("contract_doc_url")
  invoiceDocUrl  String? @map("invoice_doc_url")

  campaignId String?   @unique @map("campaign_id")
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  quoteRequestId String?      @unique @map("quote_request_id")
  quoteRequest   QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)

  /** 네트워크 매체 선택 시 [{ networkId, units, regions, lineTotal만원 }] */
  networkSelections Json? @map("network_selections")

  oohContract OohContract?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("ooh_quotes")
}

/// 버스쉘터·아파트 등 다지점 패키지 매체
model MediaNetwork {
  id          String  @id @default(cuid())
  name        String
  nameEn      String? @map("name_en")
  description String? @db.Text
  /// bus_shelter | apartment | subway_pillar | convenience_store | golf_course | highway_rest
  type        String

  pricePerUnit Int? @map("price_per_unit")
  pricePackage Int? @map("price_package")
  minUnits     Int  @default(1) @map("min_units")

  totalLocations Int      @map("total_locations")
  regions        String[] @default([])

  image         String?
  galleryImages String[] @default([]) @map("gallery_images")
  features      String?  @db.Text
  /// [{ "units": 100, "price": 5000 }, ...] 만원 단위
  packageOptions Json?   @map("package_options")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  locations MediaNetworkLocation[]

  @@index([isActive, type])
  @@map("media_networks")
}

model MediaNetworkLocation {
  id        String       @id @default(cuid())
  networkId String       @map("network_id")
  network   MediaNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)

  name      String
  address   String?
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([networkId])
  @@map("media_network_locations")
}

/// OOH 표준 계약서 + 전자서명 (OoHQuote 1:1)
model OohContract {
  id         String @id @default(cuid())
  ooHQuoteId String @unique @map("ooh_quote_id")
  ooHQuote   OoHQuote @relation(fields: [ooHQuoteId], references: [id], onDelete: Cascade)

  /** 서명 완료 PDF (Base64). 공개 다운로드는 API에서 제공 */
  signedPdfBase64 String? @map("signed_pdf_base64") @db.Text
  /** 감사용: inline | cloud URL 확장 시 */
  contractPdfUrl String @default("") @map("contract_pdf_url")

  signedAt       DateTime? @map("signed_at")
  signerName     String?   @map("signer_name")
  signerEmail    String?   @map("signer_email")
  signerIp       String?   @map("signer_ip")
  signerAgent    String?   @map("signer_agent") @db.Text
  signatureImage String?   @map("signature_image") @db.Text
  agreementAcceptedAt DateTime? @map("agreement_accepted_at")

  documentSha256 String? @map("document_sha256")
  specialTerms   String? @map("special_terms") @db.Text

  status OohContractStatus @default(pending)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("ooh_contracts")
}

/** 관리자 견적(정규화 라인 아이템) */
model Quote {
  id          String   @id @default(cuid())
  quoteNumber String   @unique @map("quote_number")
  /** draft | sent | contracted | expired */
  status      String   @default("draft")
  clientName  String   @map("client_name")
  clientEmail String?  @map("client_email")
  clientPhone String?  @map("client_phone")
  validUntil  DateTime @map("valid_until")
  subtotal    Int
  discount    Int      @default(0)
  tax         Int      @default(0)
  total       Int
  items       QuoteItem[]
  sentAt      DateTime? @map("sent_at")
  isKo        Boolean  @default(true) @map("is_ko")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("quotes")
}

model QuoteItem {
  id        String  @id @default(cuid())
  quoteId   String  @map("quote_id")
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  mediaId   String? @map("media_id")
  mediaName String  @map("media_name")
  spec      String? @map("spec")
  period    String  @map("period")
  unitPrice Int     @map("unit_price")
  quantity  Int     @default(1)
  amount    Int     @map("amount")

  @@index([quoteId])
  @@map("quote_items")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

model TrendReport {
  id                 String    @id @default(cuid())
  month              String    @unique
  status             String    @default("draft")
  titleKo            String    @map("title_ko")
  titleEn            String?   @map("title_en")
  contentKo          String    @map("content_ko") @db.Text
  summaryKo          String[]  @map("summary_ko")
  marketTrendKo      String[]  @map("market_trend_ko")
  doohTrendKo        String[]  @map("dooh_trend_ko")
  verticalStrategies Json?     @map("vertical_strategies")
  thumbnailUrl       String?   @map("thumbnail_url")
  publishedAt        DateTime? @map("published_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("trend_reports")
}

model SuccessCase {
  id             String    @id @default(cuid())
  campaignId     String?   @unique @map("campaign_id")
  campaign       Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  status         String    @default("draft")
  clientName     String    @map("client_name")
  industry       String
  titleKo        String    @map("title_ko")
  titleEn        String?   @map("title_en")
  summaryKo      String    @map("summary_ko")
  challengeKo    String    @map("challenge_ko") @db.Text
  solutionKo     String    @map("solution_ko") @db.Text
  resultsKo      String[]  @map("results_ko")
  metricsJson    Json?     @map("metrics_json")
  mediaUsed      String[]  @map("media_used")
  periodStart    DateTime? @map("period_start")
  periodEnd      DateTime? @map("period_end")
  thumbnailUrl   String?   @map("thumbnail_url")
  galleryUrls    String[]  @default([]) @map("gallery_urls")
  testimonialKo  String?   @map("testimonial_ko") @db.Text
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([publishedAt])
  @@map("success_cases")
}

model AcademyLesson {
  id             String    @id @default(cuid())
  courseId       String    @map("course_id")
  order          Int       @map("lesson_order")
  status         String    @default("draft")
  titleKo        String    @map("title_ko")
  titleEn        String?   @map("title_en")
  descriptionKo  String    @map("description_ko")
  objectivesKo   String[]  @map("objectives_ko")
  chapters       Json      @map("chapters")
  quizzes        Json?     @map("quizzes")
  durationMin    Int       @default(15) @map("duration_min")
  thumbnailUrl   String?   @map("thumbnail_url")
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([courseId, order])
  @@map("academy_lessons")
}

/// type: trend_report | academy_lesson | success_case | campaign_report | campaign_completion_pdf
model GenerationLog {
  id         String   @id @default(cuid())
  type       String
  targetId   String?  @map("target_id")
  prompt     String   @db.Text
  response   String?  @db.Text
  model      String   @map("model_name")
  tokensUsed Int?     @map("tokens_used")
  status     String
  errorMsg   String?  @map("error_msg")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@map("generation_logs")
}
