/// 공개 견적·부킹·계약 파이프라인 (`/quote`, `/quote/[id]`)
model OoHQuote {
  id     String         @id @default(cuid())
  status OoHQuoteStatus @default(draft)

  clientName    String  @map("client_name")
  clientEmail   String  @map("client_email")
  clientPhone   String? @map("client_phone")
  clientCompany String? @map("client_company")

  mediaIds    String[]  @map("media_ids")
  totalAmount Int       @map("total_amount")
  period      String
  periodKey   String?   @map("period_key")
  budgetMin   Int?      @map("budget_min")
  budgetMax   Int?      @map("budget_max")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")

  bookingRequestedAt  DateTime? @map("booking_requested_at")
  bookingConfirmedAt  DateTime? @map("booking_confirmed_at")
  invoiceSentAt       DateTime? @map("invoice_sent_at")
  paymentAmount       Int?      @map("payment_amount")
  paymentConfirmedAt  DateTime? @map("payment_confirmed_at")
  contractConfirmedAt DateTime? @map("contract_confirmed_at")

  adminNote      String?   @map("admin_note")
  cancelReason   String?   @map("cancel_reason")
  /// 고객 수정 요청 본문 (sent 상태에서만 제출; P2 처리 시 null 클리어)
  revisionMessage     String?   @map("revision_message") @db.Text
  revisionRequestedAt DateTime? @map("revision_requested_at")

  pdfTemplate    String    @default("default") @map("pdf_template")
  locale         String    @default("ko")
  quotePdfSentAt DateTime? @map("quote_pdf_sent_at")
  contractDocUrl String?   @map("contract_doc_url")
  invoiceDocUrl  String?   @map("invoice_doc_url")

  campaignId String?   @unique @map("campaign_id")
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  quoteRequestId String?       @unique @map("quote_request_id")
  quoteRequest   QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)

  contactInquiryId String?         @unique @map("contact_inquiry_id")
  contactInquiry   ContactInquiry? @relation(fields: [contactInquiryId], references: [id], onDelete: SetNull)

  priceNegotiationId String?                 @unique @map("price_negotiation_id")
  priceNegotiation   PriceNegotiationRequest? @relation(fields: [priceNegotiationId], references: [id], onDelete: SetNull)

  /** Admin formal Quote → contract pipeline bridge (P1) */
  sourceAdminQuoteId String? @unique @map("source_admin_quote_id")
  sourceAdminQuote   Quote?  @relation(fields: [sourceAdminQuoteId], references: [id], onDelete: SetNull)

  chatRoom ChatRoom?

  pipelineCard     PipelineCard?

  /// `lib/quote-calculator.ts` 산출 JSON (라인·VAT·유효기간 등)
  quoteBreakdown Json? @map("quote_breakdown")
  validUntil     DateTime? @map("valid_until")
  discountRate   Float     @default(0) @map("discount_rate")
  /// 만료 D-3 알림톡 발송 시각
  expiryNoticeSentAt DateTime? @map("expiry_notice_sent_at")

  /**
   * 네트워크 매체 선택 시 [{ networkId, units, regions, lineTotal만원 }]
   */
  networkSelections Json? @map("network_selections")

  /**
   * 견적 마법사 제출 시 매체·옵션 스냅샷
   * [{ mediaId, priceOptionIndex, optionLabel, optionPriceWon, lineTotalWon }]
   */
  mediaSelections Json? @map("media_selections")

  oohContract OohContract?

  /// 부킹 확정 시 생성된 가용 캘린더 홀드 (#224)
  mediaBookings MediaBooking[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@index([validUntil, status])
  @@map("ooh_quotes")
}

/// 버스쉘터·아파트 등 다지점 패키지 매체
