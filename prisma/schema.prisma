generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CampaignStatus {
  proposal
  negotiation
  contract
  production
  airing
  completed
}

enum MediaAvailability {
  available
  reserved
  maintenance
}

/// 예약 상태 머신.
///   requested  : 광고주가 자가 신청 (운영자 검토 전)
///   tentative  : 어드민 가홀드 (영업·견적 진행 중) — 신규 예약 차단
///   confirmed  : 확정 — 신규 예약 차단
///   cancelled  : 취소됨 — 충돌 판정 제외
///   expired    : requested 후 N일 미응답 자동 만료 (cron)
enum MediaBookingStatus {
  requested
  tentative
  confirmed
  cancelled
  expired
}

enum MediaPricePeriod {
  month
  biweekly
  week
  day
}

enum NotificationType {
  CAMPAIGN_START
  CAMPAIGN_END
  CAMPAIGN_MILESTONE
  CREATIVE_REVIEW
  CHAT_MESSAGE
  QUOTE_RECEIVED
  QUOTE_ACCEPTED
  MEDIA_AVAILABLE
  REPORT_READY
  REVIEW_REQUEST
  PRICE_CHANGE
  REGION_PRICE_TREND
  SYSTEM
  MATCH_INQUIRY
  OPEN_BID
  BID_SELECTED
}

enum ChatRoomStatus {
  OPEN
  CLOSED
}

enum ChatSenderRole {
  advertiser
  owner
  system
  admin
}

enum CreativeSubmissionStatus {
  PENDING
  AI_REVIEWING
  AI_PASSED
  AI_FAILED
  FORWARDED_TO_OWNER
}

enum PriceNegotiationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum MediaReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TeamMemberRole {
  OWNER
  ADMIN
  PLANNER
  VIEWER
}

enum CrmTier {
  vip
  standard
  lead
}

enum SalesPipelineStage {
  new_inquiry
  consulting
  quote_sent
  contract_negotiation
  contract_closed
  in_flight
  completed
}

enum FinancialDocKind {
  quote
  contract
  invoice
}

enum FinancialDocStatus {
  draft
  sent
  paid
  overdue
  cancelled
}

/// 고객 /quote 파이프라인 (관리자 정식 Quote `quotes` 테이블과 별도)
enum OoHQuoteStatus {
  draft
  sent
  expired
  booking_requested
  booking_pending
  booking_confirmed
  invoice_sent
  payment_pending
  payment_confirmed
  contract_confirmed
  in_progress
  completed
  cancelled
}

/// 전자계약 (`/quote/[id]/contract`) — 관리자 Quote와 무관
enum OohContractStatus {
  pending
  signed
  confirmed
  cancelled
}

model Media {
  id           String           @id @default(cuid())
  /// Public URL slug — `/media/[slug]`
  slug         String?          @unique
  name         String
  nameEn       String?          @map("name_en")
  location     String
  region       String
  /// 서울 권역·수도권·지방 세부 코드 (`lib/media-regions.ts`)
  regionZone   String?  @map("region_zone")
  /// Catalog code: `digital` | `static` | `mobile` (OOH 유형)
  type         String
  price        Int
  pricePeriod  MediaPricePeriod @default(month) @map("price_period")
  /// 가격 옵션 (JSON 배열). 예: [{"label":"20초 기준","price":30000000,"period":"month"},{"label":"15초 기준","price":25000000,"period":"month"}]
  priceOptions Json?            @map("price_options")
  /// 부분기간 요율 lookup — 예: {"3days":0.35,"1week":0.45,"2weeks":0.6,"3weeks":0.8}
  partialPeriodRates Json?      @map("partial_period_rates")
  image        String?
  width        String?
  height       String?

  description           String?
  subCategory           String?   @map("sub_category")
  /// 매체 카테고리 slug 배열 (대·소분류, `MediaCategory.slug`)
  mediaCategory         String[]  @default([]) @map("media_category")
  /// 공개 /media browse 대분류 (`lib/media-browse-categories.ts`)
  mediaMainCategory     String?   @map("media_main_category")
  /// 공개 /media browse 소분류
  mediaSubCategory      String?   @map("media_sub_category")
  /// 공개 /media browse 시도 (`lib/media-browse-regions.ts`)
  regionMain            String?   @map("region_main")
  /// 공개 /media browse 세부 지역
  regionSub             String?   @map("region_sub")
  /// 적합 캠페인 타겟 slug 배열 (`TargetCategory.slug`)
  targetCategory        String[]  @default([]) @map("target_category")
  tags                  String[]  @default([])
  district              String?
  city                  String?
  /// 이동형(`type=mobile`) 매체 서비스 구역 — 행정구역 5자리 코드 배열 (전국 시·군·구, 예: 서울 강남 `11680`). 공개 지도 폴리곤에 사용.
  coverageDistrictCodes String[]  @default([]) @map("coverage_district_codes")
  latitude              Float?
  longitude             Float?
  /// 복수 설치 지점 — `[{ label, location?, latitude, longitude }]`. 공개 지도·어드민 핀 복수 표시.
  installLocations      Json?     @map("install_locations")
  priceNote             String?   @map("price_note")
  widthM                Float?    @map("width_m")
  heightM               Float?    @map("height_m")
  resolution            String?
  operatingHours        String?   @map("operating_hours")
  dailyFootfall         Int?      @map("daily_footfall")
  weekdayFootfall       Int?      @map("weekday_footfall")
  targetAge             String?   @map("target_age")
  impressions           Int?
  reach                 Float?
  frequency             Float?
  cpm                   Float?
  engagementRate        Float?    @map("engagement_rate")
  visibilityScore       Int       @default(0) @map("visibility_score")
  /// 설치 연도 (옵션, 공개 검색 고급 필터)
  installYear           Int?      @map("install_year")
  effectMemo            String?   @map("effect_memo")
  /// 시간대(24)·요일(7)·월(12) 유동인구 패턴. nullable — 미입력 시 추정 사용.
  /// shape: { hourly: number[24], weekly: number[7], monthly: number[12], updatedAt?: ISO }
  trafficPattern        Json?     @map("traffic_pattern")
  extractedImages       String[]  @default([]) @map("extracted_images")
  /**
   * 광고주 이력 (쉼표 구분). 비어 있으면 집행 이력(MediaAdvertiserExecution)에서 요약
   */
  pastAdvertisers       String?   @map("past_advertisers")
  /**
   * 주변 시설 (쉼표 구분). 자동 수집·수동 입력
   */
  nearbyFacilities      String?   @map("nearby_facilities")
  /**
   * 가까운 지하철역 목록(자동·수정)
   */
  nearbyStations        String?   @map("nearby_stations")
  /**
   * 백화점·대학·관광 등 랜드마크 요약
   */
  nearbyLandmarks       String?   @map("nearby_landmarks")
  /**
   * 카카오 주소검색 등으로 좌표·행정구역이 확인된 경우
   */
  addressVerified       Boolean   @default(false) @map("address_verified")
  /**
   * 운영이 공개 카탈로그에 THINKAD Verified 리본을 붙일지 (관리자 수동)
   */
  isVerified            Boolean   @default(false) @map("is_verified")
  /**
   * 주변 시설 등 자동 수집이 수행된 시각
   */
  autoPopulatedAt       DateTime? @map("auto_populated_at")

  availability  MediaAvailability @default(available) @map("availability")
  /// 공개 상세·즉시 예약 CTA — 어드민 매체 관리 「노출」에서 수동 on/off
  instantBookingEnabled Boolean @default(false) @map("instant_booking_enabled")
  isActive      Boolean           @default(true) @map("is_active")
  /// 홈(`page.tsx`) 추천 영역 — `fetchHomeFeaturedMedia`가 `isFeatured=true` 우선 조회
  isFeatured    Boolean           @default(false) @map("is_featured")
  /// 홈 추천 정렬: 오름차순, null은 뒤로
  featuredOrder Int?              @map("featured_order")

  /// 홈 인기 매체 영역 — `fetchHomePopularMedia`가 `isPopular=true` 우선 조회 (추천과 독립)
  isPopular    Boolean @default(false) @map("is_popular")
  /// 홈 인기 정렬: 오름차순, null은 뒤로
  popularOrder Int?    @map("popular_order")

  /// 7일·30일 참여 지표 가중 합산 (`lib/media-popularity.ts`, 일일 cron 갱신)
  popularityScore     Int       @default(0) @map("popularity_score")
  popularityUpdatedAt DateTime? @map("popularity_updated_at")
  /// 누적 상세 조회수 (media_view 비콘으로 즉시 증가, 봇 제외) — 인기 폴백 정렬용
  viewCount           Int       @default(0) @map("view_count")

  /// BunnyCDN 등 외부 PDF URL (매체 제안서)
  proposalUrl      String? @map("proposal_url")
  /// 다운로드 시 파일명 (예: `강남_LED_제안서.pdf`)
  proposalFileName String? @map("proposal_file_name")
  /// 운영자 업로드 제안서 보유 여부
  hasProposal      Boolean @default(false) @map("has_proposal")

  /// 매체 소유자(매체사) — 포털 `/media-owner`
  ownerUserId String? @map("owner_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ownerUser            User?                    @relation("MediaOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  priceSnapshots       MediaPriceSnapshot[]
  bookings             MediaBooking[]
  priceChangeRequests  MediaPriceChangeRequest[]
  instantBookings      Booking[]
  advertiserExecutions MediaAdvertiserExecution[]
  reviews              MediaReview[]
  dataFusion           MediaDataFusion?
  ownerBids            MediaOwnerBid[]
  priceNegotiations       PriceNegotiationRequest[]
  campaignCreativeSubmissions CampaignCreativeSubmission[]
  chatRooms                   ChatRoom[]

  /// 네트워크 패키지 내 개별 지점과의 연결 (선택)
  networkLocations MediaNetworkLocation[]

  @@index([isFeatured, featuredOrder])
  @@index([isPopular, popularOrder])
  @@index([isActive, popularityScore(sort: Desc)])
  @@index([mediaMainCategory, mediaSubCategory])
  @@index([regionMain, regionSub])
  @@index([ownerUserId])
  @@map("media")
}

model MediaCategory {
  id          String          @id
  name        String
  slug        String          @unique
  parentId    String?         @map("parent_id")
  parent      MediaCategory?  @relation("MediaCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    MediaCategory[] @relation("MediaCategoryTree")
  icon        String?
  description String?
  order       Int             @default(0)

  @@index([parentId])
  @@map("media_categories")
}

model TargetCategory {
  id          String  @id
  name        String
  slug        String  @unique
  description String?
  icon        String?
  order       Int     @default(0)

  @@map("target_categories")
}

model MediaPriceSnapshot {
  id            String   @id @default(cuid())
  mediaId       String   @map("media_id")
  price         Int
  note          String?
  effectiveFrom DateTime @default(now()) @map("effective_from")

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@map("media_price_snapshots")
}

model RegionPriceIndex {
  id          String   @id @default(cuid())
  regionZone  String   @map("region_zone") @db.VarChar(32)
  periodMonth String   @map("period_month") @db.VarChar(7)
  avgPrice    Int      @map("avg_price")
  minPrice    Int      @map("min_price")
  maxPrice    Int      @map("max_price")
  mediaCount  Int      @map("media_count")
  changePct   Float?   @map("change_pct")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([regionZone, periodMonth])
  @@index([periodMonth(sort: Desc)])
  @@map("region_price_indices")
}

model UserRegionPriceAlert {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  regionZone String   @map("region_zone") @db.VarChar(32)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, regionZone])
  @@index([regionZone])
  @@map("user_region_price_alerts")
}

model PriceNegotiationRequest {
  id               String                 @id @default(cuid())
  mediaId          String                 @map("media_id")
  userId           String?                @map("user_id")
  contactEmail     String                 @map("contact_email") @db.VarChar(254)
  contactPhone     String                 @map("contact_phone") @db.VarChar(20)
  companyName      String?                @map("company_name") @db.VarChar(120)
  proposedPriceWon Int                  @map("proposed_price_won")
  message          String?                @db.Text
  status           PriceNegotiationStatus @default(PENDING)
  ownerNote        String?                @map("owner_note") @db.Text
  expiresAt        DateTime               @map("expires_at")
  respondedAt      DateTime?              @map("responded_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  oohQuote OoHQuote?

  @@index([mediaId, status, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@map("price_negotiation_requests")
}

model MediaBooking {
  id         String             @id @default(cuid())
  mediaId    String             @map("media_id")
  title      String
  startsAt   DateTime           @map("starts_at")
  endsAt     DateTime           @map("ends_at")
  /// 기본값 tentative — 운영자가 직접 만드는 슬롯은 가홀드부터.
  /// 광고주 자가 신청은 API 에서 명시적으로 requested 로 생성.
  status     MediaBookingStatus @default(tentative)
  campaignId String?            @map("campaign_id")
  notes      String?

  /// 광고주 자가 신청 추적 — 가입 사용자
  requestedByUserId String?   @map("requested_by_user_id")
  /// 익명 신청 시 연락처 (가입 사용자면 User 테이블 참조 우선)
  requesterName     String?   @map("requester_name")
  requesterEmail    String?   @map("requester_email")
  requesterPhone    String?   @map("requester_phone")
  /// 광고주가 입력한 희망 예산 (₩)
  budgetWon         Int?      @map("budget_won")
  /// 어드민이 status 결정한 시각 (requested → tentative/confirmed/cancelled)
  decidedAt         DateTime? @map("decided_at")
  decidedByAdminId  String?   @map("decided_by_admin_id")
  /// 매체사가 설정한 집행 불가 구간 (`/media-owner` 캘린더)
  isOwnerBlock      Boolean   @default(false) @map("is_owner_block")
  /// OoH 견적 부킹 확정 시 자동 홀드 연결 (#224)
  oohQuoteId        String?   @map("ooh_quote_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  media       Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  requestedBy User?     @relation("BookingRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  oohQuote    OoHQuote? @relation(fields: [oohQuoteId], references: [id], onDelete: SetNull)

  /// 충돌 쿼리(특정 매체 + 활성 status) 빈번 → 복합 인덱스
  @@index([mediaId, status])
  @@index([startsAt, endsAt])
  @@index([requestedByUserId])
  @@index([mediaId, oohQuoteId])
  @@index([oohQuoteId])
  @@map("media_bookings")
}

model MediaAdvertiserExecution {
  id             String    @id @default(cuid())
  mediaId        String    @map("media_id")
  advertiserName String    @map("advertiser_name")
  campaignLabel  String?   @map("campaign_label")
  periodStart    DateTime? @map("period_start")
  periodEnd      DateTime? @map("period_end")
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at")

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@map("media_advertiser_executions")
}

model CrmAccount {
  id        String   @id @default(cuid())
  email     String   @unique
  company   String
  name      String
  phone     String?
  tier      CrmTier  @default(standard)
  /// 연결된 가입 사용자
  userId    String?  @unique @map("user_id")
  /// 영업 담당자 (이메일 또는 이름)
  assignedTo String? @map("assigned_to") @db.VarChar(120)
  pipelineStage SalesPipelineStage @default(new_inquiry) @map("pipeline_stage")
  expectedAmountWon Int? @map("expected_amount_won")
  lastContactAt DateTime? @map("last_contact_at")
  firstInquiryAt DateTime? @map("first_inquiry_at")
  quoteSentAt DateTime? @map("quote_sent_at")
  stageChangedAt DateTime? @map("stage_changed_at")
  tags      String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaigns   Campaign[]
  contactLogs    CrmContactLog[]
  notes          CrmNote[]
  customerNotes  CustomerNote[]
  followUps      CrmFollowUp[]
  pipelineCard   PipelineCard?

  @@index([pipelineStage])
  @@index([assignedTo])
  @@index([lastContactAt])
  @@map("crm_accounts")
}

/// 영업 파이프라인 칸반 카드 (문의·견적·CRM 계정 연동)
model PipelineCard {
  id              String             @id @default(cuid())
  stage           SalesPipelineStage @default(new_inquiry)
  company         String
  contactName     String             @map("contact_name")
  email           String?
  phone           String?
  expectedAmount  Int                @default(0) @map("expected_amount")
  assignedTo      String?            @map("assigned_to") @db.VarChar(120)
  lastContactAt   DateTime?          @map("last_contact_at")
  firstInquiryAt  DateTime?          @map("first_inquiry_at")
  quoteSentAt     DateTime?          @map("quote_sent_at")
  stageChangedAt  DateTime?          @map("stage_changed_at")
  tags            String[]           @default([])
  sourceType      String             @default("manual") @map("source_type")
  crmAccountId    String?            @unique @map("crm_account_id")
  userId          String?            @map("user_id")
  contactInquiryId String?           @unique @map("contact_inquiry_id")
  oohQuoteId      String?            @unique @map("ooh_quote_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  crmAccount      CrmAccount?      @relation(fields: [crmAccountId], references: [id], onDelete: SetNull)
  contactInquiry  ContactInquiry?  @relation(fields: [contactInquiryId], references: [id], onDelete: SetNull)
  oohQuote        OoHQuote?        @relation(fields: [oohQuoteId], references: [id], onDelete: SetNull)

  @@index([stage])
  @@index([assignedTo])
  @@index([email])
  @@map("pipeline_cards")
}

/// 광고주 프로필 타임라인 메모
model CustomerNote {
  id            String   @id @default(cuid())
  userId        String?  @map("user_id")
  crmAccountId  String?  @map("crm_account_id")
  body          String   @db.Text
  kind          String   @default("note")
  authorLabel   String?  @map("author_label") @db.VarChar(80)
  createdAt     DateTime @default(now()) @map("created_at")

  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  crmAccount CrmAccount? @relation(fields: [crmAccountId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([crmAccountId, createdAt(sort: Desc)])
  @@map("customer_notes")
}

/// CRM 이메일 템플릿 (어드민 편집·원클릭 발송)
model EmailTemplate {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  subject   String
  bodyHtml  String   @map("body_html") @db.Text
  bodyText  String?  @map("body_text") @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_templates")
}

model CrmContactLog {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  channel   String
  summary   String
  /// pipeline_change | call | email | meeting | note
  kind      String   @default("contact")
  createdAt DateTime @default(now()) @map("created_at")

  account CrmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("crm_contact_logs")
}

model CrmNote {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account CrmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("crm_notes")
}

model CrmFollowUp {
  id             String    @id @default(cuid())
  accountId      String    @map("account_id")
  title          String
  dueAt          DateTime  @map("due_at")
  doneAt         DateTime? @map("done_at")
  remindEmail    String?   @map("remind_email")
  reminderSentAt DateTime? @map("reminder_sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  account CrmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([dueAt])
  @@map("crm_follow_ups")
}

model Campaign {
