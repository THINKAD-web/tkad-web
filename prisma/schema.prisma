model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// 트렌드 리포트 뉴스레터 구독자.
/// 같은 이메일 재신청은 unsubscribedAt 만 null 로 갱신해 재활성화.
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  /**
   * 발송 언어 ('ko' | 'en')
   */
  locale         String    @default("ko")
  /**
   * 가입 동선: 'home_community' | 'report_dashboard' | 'admin_manual' 등
   */
  source         String?
  /**
   * 가입 사용자(User) 가 있으면 함께 묶어서 어드민이 컨텍스트 확인
   */
  userId         String?   @map("user_id")
  /// 해지 시각. null = 활성. 발송 대상 필터 기준.
  unsubscribedAt DateTime? @map("unsubscribed_at")
  /**
   * 마지막 발송 시각 — 어드민 정렬·재활성화 트래킹
   */
  lastSentAt     DateTime? @map("last_sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User? @relation("UserNewsletters", fields: [userId], references: [id], onDelete: SetNull)

  @@index([unsubscribedAt])
  @@index([locale])
  @@map("newsletter_subscribers")
}

/// 뉴스레터 발송 기록 (어드민이 보낸 1회분).
/// 발송 자체의 fan-out 은 cron/queue 에서 처리하고, 이 레코드는 메타·집계.
model NewsletterDispatch {
  id             String    @id @default(cuid())
  subject        String
  /**
   * 마크다운/HTML 본문(저장만 — 발송 후 변경 X)
   */
  bodyMd         String    @db.Text
  /**
   * 발송 대상 locale 필터 ('ko' | 'en' | 'all')
   */
  localeFilter   String    @default("all") @map("locale_filter")
  recipientCount Int       @default(0) @map("recipient_count")
  successCount   Int       @default(0) @map("success_count")
  failedCount    Int       @default(0) @map("failed_count")
  scheduledAt    DateTime? @map("scheduled_at")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  /**
   * 어드민 메모(외부 노출 X)
   */
  notes          String?
  /**
   * 보낸 어드민 식별자(`tkad_admin_session` 사용자 — 단순 string 라벨)
   */
  createdByAdmin String?   @map("created_by_admin")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("newsletter_dispatches")
}

/// OAuth provider linkage (Kakao 등). NextAuth 콜백과 앱 User 를 연결합니다.
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  accessToken       String? @map("access_token") @db.Text
  refreshToken      String? @map("refresh_token") @db.Text
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token") @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model UserSession {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ip        String?
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// 공개 플래너 저장·공유 플랜. 30일 후 자동 만료.
model SavedPlannerPlan {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  /**
   * 저장 시 선택적으로 입력. 재편집·이메일 재전송 플로우에 활용
   */
  userEmail String?  @map("user_email")
  teamId    String?  @map("team_id")
  isTeamShared Boolean @default(false) @map("is_team_shared")
  /**
   * PlannerStore partialize 결과 그대로 직렬화된 입력 상태 전체
   */
  planJson  Json     @map("plan_json")
  viewCount Int      @default(0) @map("view_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([teamId, isTeamShared])
  @@map("saved_planner_plans")
}

model Team {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(120)
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner        User               @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  invites      TeamInvite[]
  plannerPlans SavedPlannerPlan[]

  @@index([ownerId])
  @@map("teams")
}

model TeamMember {
  id        String         @id @default(cuid())
  teamId    String         @map("team_id")
  userId    String         @map("user_id")
  role      TeamMemberRole
  invitedAt DateTime?      @map("invited_at")
  joinedAt  DateTime       @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@unique([userId])
  @@index([teamId])
  @@map("team_members")
}

model TeamInvite {
  id         String         @id @default(cuid())
  teamId     String         @map("team_id")
  email      String         @db.VarChar(254)
  role       TeamMemberRole @default(VIEWER)
  token      String         @unique @db.VarChar(64)
  expiresAt  DateTime       @map("expires_at")
  invitedBy  String         @map("invited_by")
  acceptedAt DateTime?      @map("accepted_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([email])
  @@map("team_invites")
}

/// AI 캠페인 제안서 저장·공유 (30일 TTL)
model SavedCampaignProposal {
  id           String   @id @default(cuid())
  expiresAt    DateTime @map("expires_at")
  userEmail    String?  @map("user_email")
  brandName    String   @map("brand_name")
  campaignName String   @map("campaign_name")
  inputJson    Json     @map("input_json")
  proposalJson Json     @map("proposal_json")
  viewCount    Int      @default(0) @map("view_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@index([userEmail])
  @@map("saved_campaign_proposals")
}

model UserFavoriteMedia {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  mediaId   String   @map("media_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, mediaId])
  @@index([mediaId])
  @@map("user_favorite_medias")
}

/// 로그인 사용자 플랜 장바구니 (매체 견적용)
model UserSavedPlan {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  items     Json     @default("[]")
  goal      String?  @map("campaign_goal")
  budget    Int?     @map("total_budget")
  duration  Int?
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_saved_plans")
}

/// 사용자가 저장한 플랜 카트 스냅샷 (보고서·사례·커뮤니티 파이프라인용)
model SavedPlanCart {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  title         String    @db.VarChar(200)
  description   String?   @db.Text
  source        String    @default("plan_cart") @db.VarChar(32)
  items         Json      @default("[]")
  campaignGoal  String?   @map("campaign_goal") @db.VarChar(32)
  totalBudget   Int?      @map("total_budget")
  duration      Int?
  reportSummary Json?     @map("report_summary")
  mediaCount    Int       @default(0) @map("media_count")
  regionsText   String?   @map("regions_text") @db.VarChar(500)
  goalTitle     String?   @map("goal_title") @db.VarChar(120)
  status        String    @default("saved") @db.VarChar(32)
  publishIntent String?   @map("publish_intent") @db.VarChar(32)
  adminNote     String?   @map("admin_note") @db.Text
  /// 사례로 승격된 SuccessCase.id
  promotedSuccessCaseId    String?   @map("promoted_success_case_id")
  /// 커뮤니티로 승격된 CommunityPost.id
  promotedCommunityPostId  String?   @map("promoted_community_post_id")
  promotedAt               DateTime? @map("promoted_at")
  /// 사용자가 저장 플랜을 내 플랜으로 불러온 횟수
  restoreCount             Int       @default(0) @map("restore_count")
  lastRestoredAt           DateTime? @map("last_restored_at")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt, createdAt(sort: Desc)])
  @@index([status])
  @@index([publishIntent])
  @@map("saved_plan_carts")
}

/// 내 플랜·플래너 보고서 조회·PDF/PPTX 다운로드 이력 (관리자 검토용)
model PlanReportActivity {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  eventType   String   @map("event_type") @db.VarChar(32)
  source      String   @db.VarChar(32)
  format      String?  @db.VarChar(16)
  mediaCount  Int      @default(0) @map("media_count")
  goalTitle   String?  @map("goal_title") @db.VarChar(120)
  regionsText String?  @map("regions_text") @db.VarChar(500)
  reportTitle String?  @map("report_title") @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([eventType])
  @@index([source])
  @@map("plan_report_activities")
}

/// 로그인 사용자 최근 본 매체 (다기기 동기화, 최대 20개는 앱 레이어에서 유지)
model UserRecentlyViewedMedia {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  mediaId   String   @map("media_id")
  name      String   @db.VarChar(200)
  type      String   @db.VarChar(64)
  region    String   @db.VarChar(64)
  thumbnail String?  @db.VarChar(512)
  price     Int      @default(0)
  visitedAt DateTime @map("visited_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, mediaId])
  @@index([userId, visitedAt(sort: Desc)])
  @@map("user_recently_viewed_medias")
}

/// 사용자 인앱 알림 (캠페인·견적·매체·리포트 등)
model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String           @db.VarChar(200)
  body      String           @db.Text
  link      String?          @db.VarChar(512)
  isRead    Boolean          @default(false) @map("is_read")
  /// cron·훅 중복 방지 (예: campaign_start:{campaignId}:{ymd})
  dedupeKey String?          @map("dedupe_key")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

/// 매체 상세 리뷰·평점 (어드민 승인 후 공개)
model MediaReview {
  id             String            @id @default(cuid())
  mediaId        String            @map("media_id")
  userId         String            @map("user_id")
  rating         Int
  title          String            @db.VarChar(120)
  body           String            @db.Text
  campaignPeriod String?           @map("campaign_period") @db.VarChar(80)
  industry       String?           @db.VarChar(60)
  isVerified     Boolean           @default(false) @map("is_verified")
  helpfulCount   Int               @default(0) @map("helpful_count")
  status         MediaReviewStatus @default(PENDING)
  campaignId     String?           @map("campaign_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  media    Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  helpfuls MediaReviewHelpful[]

  @@unique([mediaId, userId])
  @@index([mediaId, status])
  @@index([status, createdAt(sort: Desc)])
  @@map("media_reviews")
}

model MediaReviewHelpful {
  id        String   @id @default(cuid())
  reviewId  String   @map("review_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  review MediaReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("media_review_helpfuls")
}

// ── Community (Phase 3a) ─────────────────────────────────────────
// 광고주 / 매체사 / 마케터 간 Q&A · 매체 후기 · 매체 추천 게시판.
// 익명 + 가입 사용자 모두 작성 가능 (Turnstile 으로 스팸 차단).
// 신고 누적 시 자동 hidden, 어드민이 검토 후 published / deleted 결정.

model CommunityPost {
  id           String   @id @default(cuid())
  category     String // notice | free | media_recommend | execution_review | collaboration (+ legacy aliases)
  title        String   @db.VarChar(200)
  body         String   @db.Text
  /**
   * 카테고리별 부가 데이터 — media_recommend: budgetWon/region/industry,
   * execution_review: mediaId/rating/mediaReviewId
   */
  metadata     Json?
  isPinned     Boolean  @default(false) @map("is_pinned")
  authorName   String   @map("author_name") @db.VarChar(50)
  /**
   * 가입 사용자 글일 때 User.id, 익명일 때 null
   */
  authorUserId String?  @map("author_user_id")
  /**
   * 본문 내 노출 안 함 — 어드민 검토 / 답변 통보용
   */
  authorEmail  String?  @map("author_email")
  isAnonymous  Boolean  @default(false) @map("is_anonymous")
  /**
   * 작성 IP (rate limit / 신고 추적용, 일정 기간 후 익명화 가능)
   */
  authorIp     String?  @map("author_ip")
  status       String   @default("published") // published | hidden | deleted
  reportCount  Int      @default(0) @map("report_count")
  likeCount    Int      @default(0) @map("like_count")
  viewCount    Int      @default(0) @map("view_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  authorUser User?               @relation("CommunityPostAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  comments   CommunityComment[]
  likes      CommunityPostLike[]
  bookmarks  CommunityBookmark[]

  @@index([category, status, createdAt])
  @@index([status, createdAt])
  @@index([authorUserId])
  @@map("community_posts")
}

model CommunityComment {
  id           String        @id @default(cuid())
  postId       String        @map("post_id")
  post         CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  body         String        @db.Text
  authorName   String        @map("author_name") @db.VarChar(50)
  authorUserId String?       @map("author_user_id")
  authorEmail  String?       @map("author_email")
  isAnonymous  Boolean       @default(false) @map("is_anonymous")
  authorIp     String?       @map("author_ip")
  status       String        @default("published") // published | hidden | deleted
  reportCount  Int           @default(0) @map("report_count")
  createdAt    DateTime      @default(now()) @map("created_at")
  authorUser   User?         @relation("CommunityCommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([postId, status, createdAt])
  @@index([authorUserId])
  @@map("community_comments")
}

model CommunityReport {
  id             String   @id @default(cuid())
  /**
   * "post" | "comment"
   */
  targetType     String   @map("target_type")
  targetId       String   @map("target_id")
  reason         String   @db.Text
  reporterIp     String?  @map("reporter_ip")
  reporterUserId String?  @map("reporter_user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("community_reports")
}

model CommunityPostLike {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  /**
   * 가입 사용자 likeId, 익명은 ipHash
   */
  userId    String?  @map("user_id")
  ipHash    String?  @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at")

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([postId, userId], name: "post_user_unique")
  @@unique([postId, ipHash], name: "post_ip_unique")
  @@index([postId])
  @@map("community_post_likes")
}

model CommunityBookmark {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId], name: "post_bookmark_user_unique")
  @@index([postId])
  @@index([userId])
  @@map("community_bookmarks")
}

// ── Public trend reports (/[locale]/report) ─────────────────────

enum ReportCategory {
  TREND
  REGION
  GUIDE
  CAMPAIGN
}

model Report {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  summary     String         @db.Text
  content     String         @db.Text
  category    ReportCategory
  thumbnail   String?
  published   Boolean        @default(false) @map("published")
  publishedAt DateTime?      @map("published_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([published, category, publishedAt])
  @@map("reports")
}

// ── Media owner self-registration (/register/media) ─────────────

enum MediaApplicationStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
}

enum MediaPriceChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MediaOwnerSettlementStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model MediaApplication {
  id             String                 @id @default(cuid())
  companyName    String                 @map("company_name")
  contactName    String                 @map("contact_name")
  contactPhone   String                 @map("contact_phone")
  contactEmail   String                 @map("contact_email")
  mediaName      String                 @map("media_name")
  /// digital | static | other
  mediaType      String                 @map("media_type")
  address        String
  addressDetail  String?                @map("address_detail")
  zonecode       String?
  latitude       Float?
  longitude      Float?
  city           String?
  district       String?
  widthCm        Int?                   @map("width_cm")
  heightCm       Int?                   @map("height_cm")
  isDigital      Boolean                @default(false) @map("is_digital")
  operatingHours String?                @map("operating_hours")
  hasLighting    Boolean                @default(false) @map("has_lighting")
  dailyFootfall  Int?                   @map("daily_footfall")
  monthlyPrice   Int                    @map("monthly_price")
  minFlightDays  Int?                   @map("min_flight_days")
  photoFrontUrl  String                 @map("photo_front_url")
  photoSideUrl   String                 @map("photo_side_url")
  photoNightUrl  String                 @map("photo_night_url")
  notes          String?                @db.Text
  status         MediaApplicationStatus @default(PENDING)
  reviewNote     String?                @map("review_note") @db.Text
  reviewedAt     DateTime?              @map("reviewed_at")
  createdMediaId String?                @map("created_media_id")
  submitterIp    String?                @map("submitter_ip")
  /// 로그인 매체사가 제출한 경우
  userId         String?                @map("user_id")
  /// PENDING 24시간 초과 리마인더 발송 시각
  pendingReminderSentAt DateTime?       @map("pending_reminder_sent_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([userId])
  @@map("media_applications")
}

// ── 매체사 리드 발굴 · 아웃리치 · 온보딩 ───────────────────────

enum PotentialMediaSource {
  KAKAO_MAP
  GOOGLE_MAP
  MANUAL
}

enum PotentialMediaOutreachStatus {
  NEW
  CONTACT_FOUND
  EMAILED
