generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Media {
  id        String   @id @default(cuid())
  name      String
  nameEn    String?  @map("name_en")
  location  String
  region    String
  type      String
  price     Int
  image     String?
  width     String?
  height    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("media")
}

model ContactInquiry {
  id        String   @id @default(cuid())
  company   String
  name      String
  phone     String
  email     String?
  budget    String?
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_inquiries")
}

model CustomerFeedback {
  id        String   @id @default(cuid())
  email     String
  answers   Json     @map("answers")
  coupon    String   @unique @map("coupon_code")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("customer_feedback")
}

model CaseStudy {
  id          String   @id @default(cuid())
  title       String
  titleEn     String?  @map("title_en")
  description String
  descriptionEn String? @map("description_en")
  category    String
  image       String?
  client      String?
  results     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("case_studies")
}

model QuoteRequest {
  id             String   @id @default(cuid())
  company        String
  name           String
  phone          String
  email          String?
  mediaIds       String   @map("media_ids")
  period         String?
  budgetMin      Int?     @map("budget_min")
  budgetMax      Int?     @map("budget_max")
  estimatedCost  Int?     @map("estimated_cost")
  message        String?
  status         String   @default("pending")
  region         String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("quote_requests")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}
