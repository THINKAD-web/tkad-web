{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" }
      ]
    },
    {
      "source": "/(.*)/proof-upload/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(self)" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/admin-digest",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/followup-reminders",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/cron/crm-followup-alerts",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/generate-trend-report",
      "schedule": "0 0 1,15 * *"
    },
    {
      "path": "/api/cron/generate-academy-content",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/cron/generate-guide-content",
      "schedule": "0 0 * * 3,5"
    },
    {
      "path": "/api/cron/media-owner-monthly-reports",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/publish-scheduled-content",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/campaign-notifications",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/ping-sitemap",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/cron/update-media-popularity",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/expire-quotes",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/api-usage-alerts",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/daily-ops-report",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/campaign-proof-weekly",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/cron/refresh-media-data-fusion",
      "schedule": "0 3 1 * *"
    },
    {
      "path": "/api/cron/market-insights-weekly",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/cron/check-media-images",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/web-vitals-alerts",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/discover-potential-media",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/media-owner-onboarding",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/media-application-reminders",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/region-price-index",
      "schedule": "0 4 1 * *"
    },
    {
      "path": "/api/cron/price-negotiation-expire",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/campaign-renewal",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/media-owner-monthly-settlements",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/chat-owner-sla",
      "schedule": "0 */4 * * *"
    }
  ]
}
