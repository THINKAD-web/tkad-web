{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" }
      ]
    },
    {
      "source": "/(.*)/proof-upload/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(self)" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/admin-digest",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/followup-reminders",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/cron/crm-followup-alerts",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/generate-trend-report",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/campaign-notifications",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/ping-sitemap",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/cron/update-media-popularity",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/expire-quotes",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/api-usage-alerts",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/daily-ops-report",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/campaign-proof-weekly",
      "schedule": "0 0 * * 1"
    }
  ]
}
